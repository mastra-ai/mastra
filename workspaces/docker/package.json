{
  "name": "@mastra/docker",
  "version": "0.12.0",
  "description": "Docker container sandbox provider for Mastra workspaces",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown --silent --config tsdown.config.ts",
    "build:lib": "pnpm build",
    "build:watch": "pnpm build --watch",
    "test:unit": "vitest run --exclude '**/*.integration.test.ts'",
    "test:watch": "vitest watch",
    "test": "vitest run ./src/**/*.integration.test.ts",
    "test:cloud": "pnpm test",
    "lint": "oxlint --type-aware .",
    "lint:fix": "oxlint --type-aware --fix ."
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@grpc/grpc-js": "1.14.5",
    "dockerode": "^4.0.12",
    "tar-stream": "^3.2.2"
  },
  "devDependencies": {
    "@internal/lint": "workspace:*",
    "@internal/types-builder": "workspace:*",
    "@internal/workspace": "workspace:*",
    "@internal/workspace-test-utils": "workspace:*",
    "@mastra/core": "workspace:*",
    "@types/dockerode": "^4.0.2",
    "@types/node": "22.19.15",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "tsdown": "0.23.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@mastra/core": ">=1.67.0-0 <2.0.0-0"
  },
  "files": [
    "dist"
  ],
  "homepage": "https://mastra.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mastra-ai/mastra.git",
    "directory": "workspaces/docker"
  },
  "bugs": {
    "url": "https://github.com/mastra-ai/mastra/issues"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
