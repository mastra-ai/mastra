{
  "name": "@mastra/cua",
  "version": "0.0.0",
  "description": "Cua Cloud Fleet computer-use sandbox provider for Mastra workspaces",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown --silent --config tsdown.config.ts",
    "build:lib": "pnpm build",
    "build:watch": "pnpm build --watch",
    "test:unit": "vitest run --exclude '**/*.integration.test.ts'",
    "test:watch": "vitest watch",
    "test": "vitest run",
    "test:cloud": "tsx examples/agent.ts scripted",
    "lint": "oxlint . && eslint .",
    "lint:fix": "oxlint --fix . && eslint --fix .",
    "typecheck": "tsc --noEmit",
    "example": "tsx examples/agent.ts",
    "test:exports": "node --test tests/exports.mjs"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@trycua/fleet": "0.1.1",
    "pngjs": "7.0.0"
  },
  "devDependencies": {
    "@internal/lint": "workspace:*",
    "@internal/types-builder": "workspace:*",
    "@mastra/core": "workspace:*",
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "dotenv": "^17.4.2",
    "eslint": "^10.7.0",
    "tsdown": "0.22.9",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@types/pngjs": "6.0.5",
    "tsx": "catalog:"
  },
  "peerDependencies": {
    "@mastra/core": ">=1.62.0-0 <2.0.0-0"
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES"
  ],
  "homepage": "https://mastra.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mastra-ai/mastra.git",
    "directory": "workspaces/cua"
  },
  "bugs": {
    "url": "https://github.com/mastra-ai/mastra/issues"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
