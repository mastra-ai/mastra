{
  "name": "@mastra/surrealdb",
  "version": "0.0.0",
  "description": "SurrealDB provider for Mastra - includes storage and vector store capabilities",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build:lib": "tsdown --silent --config tsdown.config.ts",
    "prepack": "tsx ../../scripts/generate-package-docs.ts",
    "build:watch": "tsdown --watch --silent --config tsdown.config.ts",
    "pretest": "docker compose up -d --wait || (echo '--- docker compose up failed; dumping diagnostics ---' && docker compose ps -a && docker compose logs && df -h && exit 1)",
    "test": "vitest run",
    "posttest": "docker compose down -v",
    "pretest:watch": "docker compose up -d --wait",
    "test:watch": "vitest watch",
    "posttest:watch": "docker compose down -v",
    "lint": "oxlint --type-aware .",
    "lint:fix": "oxlint --type-aware --fix ."
  },
  "dependencies": {
    "surrealdb": "^2.1.1"
  },
  "devDependencies": {
    "@internal/core": "workspace:*",
    "@internal/lint": "workspace:*",
    "@internal/storage-test-utils": "workspace:*",
    "@internal/types-builder": "workspace:*",
    "@mastra/core": "workspace:*",
    "@mastra/memory": "workspace:*",
    "@types/node": "22.19.15",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "tsdown": "0.23.1",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@mastra/core": ">=1.76.0-0 <2.0.0-0"
  },
  "files": [
    "dist"
  ],
  "license": "Apache-2.0",
  "homepage": "https://mastra.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mastra-ai/mastra.git",
    "directory": "stores/surrealdb"
  },
  "bugs": {
    "url": "https://github.com/mastra-ai/mastra/issues"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
