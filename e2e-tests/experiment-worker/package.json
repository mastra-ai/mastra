{
  "name": "experiment-worker-e2e-test",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Installed-package E2E tests for the experiment worker artifact",
  "scripts": {
    "test": "vitest run $PWD/tests/setup.test.ts $PWD/tests/harness.test.ts $PWD/tests/minimal-agent.test.ts $PWD/tests/target-process.test.ts $PWD/tests/runtime-resources.test.ts $PWD/tests/native-duckdb.test.ts",
    "test:pr": "MASTRA_EXPERIMENT_E2E_SCENARIO= MASTRA_EXPERIMENT_E2E_TIER=pr vitest run $PWD/tests/setup.test.ts $PWD/tests/harness.test.ts $PWD/tests/minimal-agent.test.ts $PWD/tests/target-process.test.ts $PWD/tests/runtime-resources.test.ts $PWD/tests/native-duckdb.test.ts",
    "test:full": "MASTRA_EXPERIMENT_E2E_SCENARIO= MASTRA_EXPERIMENT_E2E_TIER=full vitest run $PWD/tests/setup.test.ts $PWD/tests/harness.test.ts $PWD/tests/minimal-agent.test.ts $PWD/tests/target-process.test.ts $PWD/tests/runtime-resources.test.ts $PWD/tests/native-duckdb.test.ts $PWD/tests/full-workspace-lifecycle.test.ts $PWD/tests/postgres-lifecycle.test.ts $PWD/tests/project-shapes.test.ts $PWD/tests/portability-isolation.test.ts $PWD/tests/installed-boundary-negative.test.ts",
    "test:full:strict": "MASTRA_EXPERIMENT_E2E_SCENARIO= MASTRA_EXPERIMENT_E2E_TIER=full vitest run $PWD/tests/setup.test.ts $PWD/tests/harness.test.ts $PWD/tests/minimal-agent.test.ts $PWD/tests/target-process.test.ts $PWD/tests/runtime-resources.test.ts $PWD/tests/native-duckdb.test.ts $PWD/tests/full-workspace-lifecycle.test.ts $PWD/tests/postgres-lifecycle.test.ts $PWD/tests/project-shapes.test.ts $PWD/tests/portability-isolation.test.ts $PWD/tests/installed-boundary-negative.test.ts",
    "test:scenario": "node scripts/run-scenario.mjs",
    "test:workflow-routing": "vitest run --config vitest.routing.config.ts"
  },
  "devDependencies": {
    "@libsql/client": "^0.17.4",
    "@types/node": "^26.0.0",
    "get-port": "^7.2.0",
    "tinyglobby": "^0.2.17",
    "verdaccio": "^6.7.4",
    "verdaccio-auth-memory": "^13.0.3",
    "vitest": "^4.1.10"
  }
}
