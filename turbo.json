{
  "$schema": "https://v2-9-16.turborepo.dev/schema.json",
  "ui": "stream",
  "futureFlags": {
    "affectedUsingTaskInputs": true
  },
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "outputLogs": "new-only"
    },
    "lint": {
      "dependsOn": []
    },
    "lint:fix": {
      "dependsOn": [],
      "cache": false
    },
    "//#lint:format": {
      "dependsOn": [],
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    // The watch rebuilds dist from scratch, so it cannot run while `build` writes the same directory.
    "@mastra/playground-ui#dev": {
      "dependsOn": ["^build", "@mastra/playground-ui#build"],
      "cache": false,
      "persistent": true
    },
    // The Vercel preview bundle is a deploy artifact, not a package build: it stays out of the
    // repo-wide `build` task so CI never bundles it, and it is never cached.
    "studio-preview#build:vercel": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "validate:package": {
      "dependsOn": []
    },
    "//#format:oxfmt": {
      "dependsOn": [],
      "cache": false
    }
  }
}
