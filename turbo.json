{
  "$schema": "https://v2-9-16.turborepo.dev/schema.json",
  "ui": "stream",
  "futureFlags": {
    "affectedUsingTaskInputs": true
  },
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "outputLogs": "new-only"
    },
    "lint": {
      "dependsOn": [],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/oxlint.config.ts"]
    },
    "lint:fix": {
      "dependsOn": [],
      "cache": false
    },
    "//#lint:format": {
      "dependsOn": [],
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    // The watch rebuilds dist from scratch, so it cannot run while `build` writes the same directory, nor while a
    // dependent's build reads it (mcp-apps-components bundles playground-ui components).
    "@mastra/playground-ui#dev": {
      "dependsOn": ["^build", "@mastra/playground-ui#build", "@mastra/mcp-apps-components#build"],
      "cache": false,
      "persistent": true
    },
    "@mastra/react#dev": {
      "dependsOn": ["^build", "@mastra/react#build"],
      "cache": false,
      "persistent": true
    },
    "validate:package": {
      "dependsOn": []
    },
    "//#format:oxfmt": {
      "dependsOn": [],
      "cache": false
    }
  }
}
