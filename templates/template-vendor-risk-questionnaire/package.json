{
  "name": "template-vendor-risk-questionnaire",
  "version": "0.1.0",
  "private": true,
  "description": "A local Mastra template for generic vendor risk questionnaires.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": "^22.22.0 || >=24.12.0"
  },
  "scripts": {
    "setup": "node scripts/setup.ts",
    "dev": "mastra dev",
    "build": "mastra build",
    "start": "mastra start",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run"
  },
  "dependencies": {
    "@mastra/core": "latest"
  },
  "devDependencies": {
    "@mastra/evals": "latest",
    "@types/node": "^22.20.1",
    "mastra": "latest",
    "oxfmt": "0.72.0",
    "typescript": "^5.9.3",
    "vitest": "4.1.11"
  }
}
