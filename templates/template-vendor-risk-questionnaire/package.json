{
  "name": "template-vendor-risk-questionnaire",
  "version": "0.1.0",
  "private": true,
  "description": "A local Mastra template for generic vendor risk questionnaires.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": "^22.22.0 || >=24.12.0"
  },
  "scripts": {
    "setup": "node scripts/setup.ts",
    "dev": "MASTRA_TELEMETRY_DISABLED=1 mastra dev",
    "build": "MASTRA_TELEMETRY_DISABLED=1 mastra build",
    "start": "MASTRA_TELEMETRY_DISABLED=1 mastra start",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "intake": "node scripts/intake.ts",
    "demo": "node scripts/generate-demo.ts"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "@mastra/core": "latest",
    "@mastra/libsql": "latest",
    "csv-parse": "7.0.3",
    "fast-xml-parser": "5.11.2",
    "fflate": "0.8.3",
    "pdfjs-dist": "6.4.299",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@mastra/evals": "latest",
    "@types/node": "^22.20.1",
    "mastra": "latest",
    "oxfmt": "0.72.0",
    "typescript": "^5.9.3",
    "vitest": "4.1.11"
  }
}
