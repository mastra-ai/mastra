# The model the agent runs on. Any model Mastra can route to works; leave this
# unset for the default, openai/gpt-5.6-sol.
# AGENT_MODEL=openai/gpt-5.6-sol

# Powers the agent model. OpenAI is the default; uncomment the key for the
# provider you set in AGENT_MODEL.
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
#
# See all supported providers: https://mastra.ai/models/environment-variables

# There is no variable for workspace isolation, and nothing to turn it off.
# Every caller gets its own home directory — its own ~/.circle-cli, its own
# wallet, its own files — keyed by the `user-id` it sends in `requestContext`,
# and a request that names no caller is refused rather than pooled. That is the
# same locally and deployed. See `src/mastra/tenancy.ts`.
#
# It is one half of a pair: nothing here checks that a caller is who it says it
# is, so put something in front that authenticates callers and sets their id.

# Uncomment this on corporate networks that install a TLS certificate in the system trust store.
# Requires Node.js 22.15 or later.
# NODE_OPTIONS=--use-system-ca

# Circle needs no API key. The Circle CLI holds the session, and you log in
# yourself in your own terminal:
#
#   npm install -g @circle-fin/cli
#   circle wallet login
#   circle wallet status
#
# Accept Circle's Terms of Use at that prompt. An agent must never accept them
# on your behalf, so this template will not do it for you.
# https://developers.circle.com/agent-stack

# Shared secret for the /circle/* control-plane routes, which accept Circle's
# Terms of Use and complete an OTP sign-in on behalf of a caller who has no
# shell on this machine. The front end sends it as `x-control-plane-token`.
#
# Unset means those routes refuse every request. That is the intended default:
# they are the two steps this agent is forbidden to take, and an open one on a
# public URL lets a stranger accept someone else's Terms and start a login
# against their wallet. Generate one per deployment, e.g. `openssl rand -hex 32`.
CONTROL_PLANE_TOKEN=
