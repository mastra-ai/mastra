# Required by the application configuration; obtain from the OpenAI API dashboard.
OPENAI_API_KEY=
# Required only for enabled Drive sources; service account email and PEM key.
GOOGLE_DRIVE_CLIENT_EMAIL=
# Quote the PEM value and preserve its escaped \n line breaks.
GOOGLE_DRIVE_PRIVATE_KEY=
# Required only for enabled S3/R2 sources. Use Object Read credentials scoped to the configured bucket.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
