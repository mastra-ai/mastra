# Gateway — single key proxies to OpenAI, Anthropic, Google, etc.
# https://mastra.ai/docs/models/gateways/mastra
MASTRA_GATEWAY_API_KEY=

# Turso (libSQL) — used for observability + observational memory
# Create a database at https://turso.tech, then copy the URL + auth token.
# Example: libsql://my-db.turso.io
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional: model router id for the agent, e.g. mastra/openai/gpt-5-mini or
# anthropic/claude-sonnet-4-5. Defaults to mastra/openai/gpt-5-mini.
AGENT_MODEL=
