# Gateway — routes models and provider-native web search.
# Get one at https://gateway.mastra.ai
MASTRA_GATEWAY_API_KEY=

# Neon Postgres connection string (with `?sslmode=require`).
# pgvector must be available on the database; Neon supports it out of the box.
DATABASE_URL=postgresql://user:pass@host.neon.tech/dbname?sslmode=require

# Mastra platform — powers @mastra/connect. Attach Linear and Notion
# connections to your Mastra platform project, then generate an access token.
MASTRA_PLATFORM_ACCESS_TOKEN=
MASTRA_PROJECT_ID=

# Optional: model router id for the agent, e.g. mastra/openai/gpt-5.4 or
# anthropic/claude-sonnet-4-5. Defaults to mastra/openai/gpt-5.4. Web search is
# only available with OpenAI models.
AGENT_MODEL=
