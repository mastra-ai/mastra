# `npm create factory` fills these in when it provisions your platform project.
# For a direct checkout, copy the values from your Mastra platform project.

# Mastra platform: sign-in, platform sandboxes, and integrations.
# MASTRA_PLATFORM_SECRET_KEY=
# MASTRA_ORGANIZATION_ID=
# MASTRA_PROJECT_ID=
# MASTRA_ENVIRONMENT_ID=

# PostgreSQL with pgvector. Deployments receive this from the platform database.
# DATABASE_URL=

# Credential encryption — generate once with `openssl rand -base64 32` and keep a backup.
# FACTORY_CREDENTIAL_ENCRYPTION_KEY=
