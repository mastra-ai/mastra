# Filled in by `npm create factory`. For a manual setup, copy them from your Mastra platform project.
# MASTRA_PLATFORM_SECRET_KEY=
# MASTRA_ORGANIZATION_ID=
# MASTRA_PROJECT_ID=
# MASTRA_ENVIRONMENT_ID=

# PostgreSQL with pgvector. Filled in by `npm create factory`.
# DATABASE_URL=

# Public URL of this server. Defaults to http://localhost:4111.
# MASTRACODE_PUBLIC_URL=

# Encrypts stored credentials. Generated by `npm create factory` (or `openssl rand -base64 32`).
# Keep it stable and backed up: losing it makes stored credentials unreadable.
# FACTORY_CREDENTIAL_ENCRYPTION_KEY=
