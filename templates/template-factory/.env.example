# Filled in by `npm create factory`. For a manual setup, copy them from your Mastra platform project.
# MASTRA_PLATFORM_SECRET_KEY=
# MASTRA_ORGANIZATION_ID=
# MASTRA_PROJECT_ID=
# MASTRA_ENVIRONMENT_ID=

# PostgreSQL with pgvector. Filled in by `npm create factory`.
# DATABASE_URL=

# Public URL of this server. Defaults to http://localhost:4111.
# MASTRACODE_PUBLIC_URL=

# Optional Slack app. Set all four below to enable webhook mode, or replace
# SLACK_APP_SIGNING_SECRET with SLACK_APP_TOKEN (xapp-...) for Socket Mode.
# A bot token alone cannot receive events or link users. SLACK_BOT_TOKEN is
# accepted as an alias for SLACK_APP_BOT_TOKEN.
# SLACK_APP_SIGNING_SECRET=
# SLACK_APP_TOKEN=
# SLACK_APP_BOT_TOKEN=
# SLACK_APP_CLIENT_ID=
# SLACK_APP_CLIENT_SECRET=
# Account linking needs an HTTPS redirect URL. Set MASTRACODE_PUBLIC_URL above
# to your HTTPS Factory origin, or use this override for a local HTTPS tunnel.
# MASTRACODE_CHANNELS_PUBLIC_URL=

# Encrypts stored credentials. Generated by `npm create factory` (or `openssl rand -base64 32`).
# Keep it stable and backed up: losing it makes stored credentials unreadable.
# FACTORY_CREDENTIAL_ENCRYPTION_KEY=
