# OpenAI API key for interactive questions.
OPENAI_API_KEY=
ANALYSIS_MODEL=gpt-4.1-mini
# Local storage for sample data and saved conversations.
DATA_DIRECTORY=.data
AGENT_PORT=4111
WEB_PORT=3000
# Optional server-side OpenAI-compatible endpoint; leave unset for the default provider.
# ANALYSIS_BASE_URL=
# Optional enabled source and unique registered component selections; leave unset for defaults.
# SOURCE_ID=sales
# UI_COMPONENT_IDS=metric,line,bar,table
NEXT_TELEMETRY_DISABLED=1
COPILOTKIT_TELEMETRY_DISABLED=true
