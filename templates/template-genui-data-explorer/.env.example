# Interactive questions use this server-side key; deterministic checks need no credentials.
OPENAI_API_KEY=
ANALYSIS_MODEL=gpt-4.1-mini
# Launch initializes once and preserves Sales, workspace, memory, domain diagnostics and native traces.
DATA_DIRECTORY=.data
AGENT_PORT=4111
WEB_PORT=3000
# Optional server-side OpenAI-compatible endpoint; leave unset for the default provider.
# ANALYSIS_BASE_URL=
# Optional enabled source and unique registered component selections; leave unset for defaults.
# SOURCE_ID=sales
# UI_COMPONENT_IDS=metric,line,bar,table
NEXT_TELEMETRY_DISABLED=1
COPILOTKIT_TELEMETRY_DISABLED=true
# Live benchmark approval/pricing/budget is separate; see README before invoking benchmark:live.
