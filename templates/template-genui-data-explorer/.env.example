# Interactive questions use this server-side key; deterministic checks need no credentials.
OPENAI_API_KEY=
ANALYSIS_MODEL=gpt-4.1-mini
# npm run dev initializes once and preserves all three local SQLite files here.
DATA_DIRECTORY=.data
AGENT_PORT=4111
WEB_PORT=3000
# Supported telemetry opt-outs are also enforced by the local launcher.
NEXT_TELEMETRY_DISABLED=1
COPILOTKIT_TELEMETRY_DISABLED=true
# Optional settings for the separate legacy NDJSON endpoint (npm start):
SALES_DATA_PATH=.data/sales.sqlite
PORT=4111
