# OpenAI credential. Paid dispatch stays disabled until a spending budget is configured.
OPENAI_API_KEY=
POLICY_OPERATOR_ID=local-broker
PORT=4111
# Relative to the project root, or an absolute private directory.
POLICY_DATA_DIR=.runtime

# Optional model override and explicitly approved JSON processing budget (see docs/usage.md).
# POLICY_EXTRACTION_MODEL=gpt-6.1-sol
# Example ceilings only; replace the illustrative token prices with conservative prices for your model.
# Uncomment after choosing the limits you want to authorize.
# POLICY_PROCESSING_BUDGET='{"maxAttempts":2,"maxRequests":6,"maxInputTokensPerRequest":200000,"maxOutputTokensPerRequest":16000,"maxTotalTokens":1300000,"maxCostMicros":20000000,"inputMicrosPerToken":10,"outputMicrosPerToken":50,"pricingAssumption":"Illustrative prices; replace before use","timeoutMs":240000,"maxResponseBytes":4194304}'
