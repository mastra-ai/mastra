# OpenAI credential. Paid dispatch stays disabled until a spending budget is configured.
OPENAI_API_KEY=
POLICY_OPERATOR_ID=local-broker
PORT=4111
# Relative to the project root, or an absolute private directory.
POLICY_DATA_DIR=.runtime

# Optional model override and explicitly approved JSON processing budget (see docs/usage.md).
# POLICY_EXTRACTION_MODEL=gpt-6.1-sol
# POLICY_PROCESSING_BUDGET=
