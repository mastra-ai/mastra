# Factory Server
# Public origin of this server. Local dev defaults to http://localhost:4111.
# MASTRACODE_PUBLIC_URL=

# Credential encryption — generate once with `openssl rand -base64 32` and keep a backup.
FACTORY_CREDENTIAL_ENCRYPTION_KEY=

# PostgreSQL with pgvector. `npm run db:up` starts one at:
# postgres://factory:factory@localhost:54329/factory
DATABASE_URL=

# WorkOS sign-in
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
# 32+ characters, used to seal session cookies.
WORKOS_COOKIE_PASSWORD=
# Optional — defaults to <MASTRACODE_PUBLIC_URL>/auth/callback.
# WORKOS_REDIRECT_URI=

# GitHub App
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_SLUG=
GITHUB_APP_WEBHOOK_SECRET=
