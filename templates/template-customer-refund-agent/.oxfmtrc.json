{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "endOfLine": "lf",
  "semi": true,
  "singleQuote": true,
  "tabWidth": 2,
  "useTabs": false,
  "trailingComma": "all",
  "bracketSpacing": true,
  "printWidth": 120,
  "arrowParens": "avoid",
  "sortPackageJson": false,
  "sortTailwindcss": true,
  "ignorePatterns": [
    "**/.agents/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/.mastra/**",
    "**/.data/**",
    "**/coverage/**",
    "**/playwright-report/**",
    "**/test-results/**",
    "**/public/**",
    "**/generated/**",
    "package-lock.json"
  ]
}
