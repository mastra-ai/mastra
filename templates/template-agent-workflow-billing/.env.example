# Required for image generation; local setup does not contact OpenAI.
OPENAI_API_KEY=
BILLING_MODE=local
BILLING_PROVIDER=local
BILLING_PORT=4111

# Optional authenticated native Studio Assistant chat and billing Tools Playground.
BILLING_STUDIO_ENABLED=false

# Optional Autumn mode requires JWT identity,
# and external JSON configuration files. Paths resolve from the project root.
# BILLING_CONFIG_FILE is an optional full override; plans/meters/policies normally stay in TypeScript.
# Explicit empty/missing/invalid files fail startup. See docs/autumn.md. Never commit secrets.
# Autumn uses BILLING_MODE=production and BILLING_PROVIDER=autumn, including sandbox.
# Provision JWT principals and remote allowance separately; local setup does not do this.
# BILLING_IDENTITY_CONFIG_FILE=configuration/identity.json
# BILLING_CONFIG_FILE=configuration/billing.json
# AUTUMN_SECRET_KEY=
# AUTUMN_CONFIG_FILE=configuration/autumn.json
# AUTUMN_TEST_CUSTOMER_ID=johns-org
# AUTUMN_TEST_FEATURE_ID=generated_images
# AUTUMN_TEST_CREDIT_POOL_ID=image_credits

# Optional image profile overrides. Billing always generates one PNG per slot.
# OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
# OPENAI_IMAGE_QUALITY=low
# OPENAI_IMAGE_SIZE=1024x1024
