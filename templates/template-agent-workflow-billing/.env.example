# Required for image generation; local setup does not contact OpenAI.
OPENAI_API_KEY=
BILLING_MODE=local
BILLING_PROVIDER=local
BILLING_PORT=4111

# Optional authenticated billing actions in Studio > Tools.
BILLING_STUDIO_ENABLED=false

# Optional Autumn mode requires JWT identity, complete BILLING_CONFIGURATION,
# and trusted JSON AUTUMN_BINDINGS. See docs/autumn.md. Never commit secrets.
# Autumn uses BILLING_MODE=production and BILLING_PROVIDER=autumn, including sandbox.
# Provision JWT principals and remote allowance separately; local setup does not do this.
# BILLING_JWT_CONFIGURATION=
# BILLING_CONFIGURATION=
# AUTUMN_SECRET_KEY=
# AUTUMN_BINDINGS=
# AUTUMN_TEST_CUSTOMER_ID=johns-org
# AUTUMN_TEST_FEATURE_ID=generated_images
# AUTUMN_TEST_CREDIT_POOL_ID=image_credits

# Optional image profile overrides. Billing always generates one PNG per slot.
# OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
# OPENAI_IMAGE_QUALITY=low
# OPENAI_IMAGE_SIZE=1024x1024
