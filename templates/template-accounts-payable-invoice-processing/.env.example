INVOICE_READER_MODEL=openai/gpt-5.6-sol
OPENAI_API_KEY=
# MASTRA_DB_URL=file:/absolute/path/to/mastra.db

# Accounting provider and provider-neutral AP policy.
ACCOUNTING_PROVIDER=quickbooks-mcp
AP_APPROVAL_THRESHOLD_MINOR=100000
AP_AMOUNT_TOLERANCE_MINOR=1
AP_LOW_CONFIDENCE_THRESHOLD=0.8
# Sandbox-only acknowledgement. Keep false when real screening is required.
AP_ALLOW_UNSCREENED_VENDORS=false

# Included Intuit QuickBooks MCP adapter.
QBO_MCP_SERVER_PATH=
QBO_MCP_TOKEN_STORE_PATH=
# Posting is opt-in. Use QuickBooks internal account IDs, never account names.
QBO_MCP_ENABLE_POSTING=false
# Required acknowledgement when posting: run exactly one posting replica.
QBO_MCP_SINGLE_WRITER=false
# Optional absolute or relative directory for cross-process posting locks.
QBO_MCP_POSTING_LOCK_DIR=
QBO_MCP_EXPENSE_ACCOUNT_ID=
QBO_MCP_TAX_ACCOUNT_ID=
QBO_MCP_AP_ACCOUNT_ID=
