{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "endOfLine": "lf",
  "semi": true,
  "singleQuote": true,
  "tabWidth": 2,
  "useTabs": false,
  "trailingComma": "all",
  "bracketSpacing": true,
  "printWidth": 120,
  "arrowParens": "avoid",
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules/**",
    ".mastra/**",
    ".local/**",
    ".npm-cache/**",
    "data/**",
    "dist/**",
    "coverage/**",
    "package-lock.json",
    ".env*"
  ]
}
