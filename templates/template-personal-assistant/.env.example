OPENAI_API_KEY=

# Optional local configuration.
# ASSISTANT_OWNER_ID=local-owner
# AGENT_MODEL=openai/gpt-6-luna
# Platform sets AGENT_MODEL (for example mastra/openai/gpt-6-luna); it takes precedence over ASSISTANT_MODEL.
# Gateway models do not require OPENAI_API_KEY. ASSISTANT_MODEL remains a fallback.
# ASSISTANT_MAX_STEPS=20
# Optional defaults for assistant responses, including scheduled checks (not the goal judge).
# ASSISTANT_MAX_OUTPUT_TOKENS=512
# ASSISTANT_MODEL_MAX_RETRIES=0
# The judge defaults to the selected AGENT_MODEL; optionally override it.
# ASSISTANT_JUDGE_MODEL=mastra/openai/gpt-6-luna
# ASSISTANT_MAX_GOAL_EVALUATIONS=5
# ASSISTANT_TIMEZONE=America/Sao_Paulo

# Optional Mastra Connect. Configure both values and authorize provider accounts separately.
# MASTRA_PROJECT_ID=
# MASTRA_PLATFORM_ACCESS_TOKEN=
# MASTRA_PLATFORM_SECRET_KEY=
# MASTRA_ORG_ID=
# MASTRA_PLATFORM_REGION=us
# ASSISTANT_CONNECT_PROVIDERS=["google-mail","google-docs","notion","jira"]
# ASSISTANT_CONNECT_TOOLS=["google_mail_get_message","google_docs_create_document","google_docs_insert_text"]

# Optional hosted operation on Mastra Platform. Local data is not uploaded.
# ASSISTANT_RUNTIME=hosted
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=
# ASSISTANT_API_TOKEN=
# Preserve the template's single-owner SimpleAuth instead of organization-wide Studio auth.
# MASTRA_PLATFORM_STUDIO_AUTH=disabled
# Optional Platform trace export requires hosted mode and the project/access token above.
# ASSISTANT_PLATFORM_TRACING=true
