dresses, prefixes and children go in as\n * JSON arrays so a large read scope never hits a bind-parameter limit. Each kind is its own index\n * lookup (address equality, address range for a prefix, `(declaration, parentId)` for children),\n * unioned, so the cost follows the caller's reach rather than the number of scopes in the store.\n */\nfunction readableScopes(read: KnowledgeReadScope): Fragment {\n  if (read === 'all') return { sql: `SELECT id FROM \"${T.pages}\" WHERE isScope = 1`, args: [] };\n  const parts: string[] = [];\n  const args: InValue[] = [];\n  if (read.addresses.length > 0) {\n    parts.push(`SELECT id FROM \"${T.pages}\" WHERE isScope = 1 AND address IN (SELECT value FROM json_each(?))`);\n    args.push(JSON.stringify(read.addresses));\n  }\n  if (read.prefixes.length > 0) {\n    parts.push(\n      `SELECT sp.id FROM json_each(?) j CROSS JOIN \"${T.pages}\" sp ON sp.isScope = 1 AND sp.address >= json_extract(j.value, '$.lo') AND sp.address < json_extract(j.value, '$.hi') AND +sp.declaration = json_extract(j.value, '$.declaration')`,\n    );\n    args.push(\n      JSON.stringify(\n        read.prefixes.map(entry => ({\n          declaration: entry.declaration,\n          lo: entry.prefix,\n          hi: prefixUpperBound(entry.prefix),\n        })),\n      ),\n    );\n  }\n  if (read.children.length > 0) {\n    parts.push(\n      `SELECT sp.id FROM json_each(?) j CROSS JOIN \"${T.pages}\" sp ON sp.isScope = 1 AND sp.declaration = json_extract(j.value, '$.declaration') AND sp.parentId IS json_extract(j.value, '$.parentId')`,\n    );\n    args.push(JSON.stringify(read.children));\n  }\n  if (parts.length === 0) return { sql: `SELECT id FROM \"${T.pages}\" WHERE 0`, args: [] };\n  return { sql: parts.join(' UNION '), args };\n}\n\n/** `alias.scopeId` is readable. */\nfunction pageReadable(alias: string, read: KnowledgeReadScope): Fragment {\n  const scopes = readableScopes(read);\n  return { sql: `${alias}.scopeId IN (${scopes.sql})`, args: scopes.args };\n}\n\n/**\n * Note `alias` is visible: its page's scope is readable, a stamp is readable, and every resolved\n * mention's page sits in a readable scope.\n */\nfunction noteReadable(alias: string, read: KnowledgeReadScope): Fragment {\n  const scopes = readableScopes(read);\n  return {\n    sql: `EXISTS (SELECT 1 FROM \"${T.pages}\" vp WHERE vp.id = ${alias}.pageId AND vp.scopeId IN (${scopes.sql}))\n      AND EXISTS (SELECT 1 FROM \"${T.stamps}\" vs WHERE vs.noteId = ${alias}.id AND vs.scopeId IN (${scopes.sql}))\n      AND NOT EXISTS (SELECT 1 FROM \"${T.mentions}\" vm JOIN \"${T.pages}\" vmp ON vmp.id = vm.pageId WHERE vm.noteId = ${alias}.id AND vmp.scopeId NOT IN (${scopes.sql}))`,\n    args: [...scopes.args, ...scopes.args, ...scopes.args],\n  };\n}\n\nfunction jsonList(values: string[]): string {\n  return JSON.stringify(values);\n}\n\nexport class LibSQLKnowledgePages implements KnowledgePageStore {\n  readonly #read: PageExecutor;\n  readonly #transaction: PageTransaction;\n\n  constructor(config: { read: PageExecutor; transaction: PageTransaction }) {\n    this.#read = config.read;\n    this.#transaction = config.transaction;\n  }\n\n  /** Deletes every row from the page tables (scopes, pages, notes, pins, activity, links). */\n  async clearAll(): Promise<void> {\n    await this.#transaction(async tx => {\n      for (const table of [T.links, T.activity, T.pinAudiences, T.pins, T.mentions, T.stamps, T.notes, T.pages]) {\n        await tx.execute({ sql: `DELETE FROM ${table}`, args: [] });\n      }\n    });\n  }\n\n  async #query(executor: PageExecutor, sql: string, args: InValue[] = []): Promise<Row[]> {\n    const result = await executor.execute({ sql, args });\n    return result.rows as unknown as Row[];\n  }\n\n  async #pageRow(executor: PageExecutor, id: string): Promise<Row | undefined> {\n    return (await this.#query(executor, `SELECT * FROM \"${T.pages}\" WHERE id = ?`, [id]))[0];\n  }\n\n  async #livePage(executor: PageExecutor, id: string): Promise<Row> {\n    const row = await this.#pageRow(executor, id);\n    if (!row || row.deletedAt) throw new KnowledgeNotFoundError('page', id);\n    return row;\n  }\n\n  async #logActivity(\n    tx: PageExecutor,\n    action: KnowledgePageActivityAction,\n    event: { scopeId: string; pageId: string; noteId?: string; provenance: KnowledgeProvenance },\n    now: string,\n  ): Promise<void> {\n    await tx.execute({\n      sql: `INSERT INTO \"${T.activity}\" (id, action, scopeId, pageId, noteId, provenance, createdAt) VALUES (?, ?, ?, ?, ?, ?, ?)`,\n      args: [\n        createKnowledgeUlid(),\n        action,\n        event.scopeId,\n        event.pageId,\n        event.noteId ?? null,\n        JSON.stringify(event.provenance),\n        now,\n      ],\n    });\n  }\n\n  async #lastPosition(tx: PageExecutor, parentId: string | null, scopesOnly: boolean): Promise<string | undefined> {\n    const rows = await this.#query(\n      tx,\n      `SELECT position FROM \"${T.pages}\" WHERE parentId IS ? AND isScope = ? AND deletedAt IS NULL ORDER BY position DESC, id DESC LIMIT 1`,\n      [parentId, scopesOnly ? 1 : 0],\n    );\n    return rows[0] ? String(rows[0].position) : undefined;\n  }\n\n  // Scopes\n\n  async materializeScope(input: MaterializeKnowledgeScopeInput): Promise<MaterializeKnowledgeScopeResult> {\n    const core = await loadPagesCore();\n    await assertKnowledgePageDescriptionWithinBound(input.description);\n    return this.#transaction(async tx => {\n      const now = new Date().toISOString();\n      const ensureScope = async (\n        spec: { address: string; declaration: string; name: string; description?: string },\n        parentId: string | null,\n      ) => {\n        await assertKnowledgePageDescriptionWithinBound(spec.description);\n        const existing = (\n          await this.#query(tx, `SELECT * FROM \"${T.pages}\" WHERE isScope = 1 AND address = ?`, [spec.address])\n        )[0];\n        if (existing) return { row: existing, created: false };\n        if (parentId !== null) await this.#livePage(tx, parentId);\n        const id = createKnowledgeUlid();\n        const position = core.knowledgePositionBetween(await this.#lastPosition(tx, parentId, true));\n        const who = JSON.stringify(input.provenance);\n        await tx.execute({\n          sql: `INSERT INTO \"${T.pages}\" (id, scopeId, isScope, address, declaration, parentId, position, path, depth, name, canonicalName, description, version, createdBy, updatedBy, createdAt, updatedAt) VALUES (?, ?, 1, ?, ?, ?, ?, ?, 0, ?, ?, ?, 1, ?, ?, ?, ?)`,\n          args: [\n            id,\n            id,\n            spec.address,\n            spec.declaration,\n            parentId,\n            position,\n            `/${id}/`,\n            spec.name,\n            core.canonicalKnowledgeName(spec.name),\n            spec.description ?? null,\n            who,\n            who,\n            now,\n            now,\n          ],\n        });\n        await this.#logActivity(tx, 'scope-created', { scopeId: id, pageId: id, provenance: input.provenance }, now);\n        return { row: (await this.#pageRow(tx, id))!, created: true };\n      };\n\n      const ensured = await ensureScope(input, input.parentId ?? null);\n      let row = ensured.row;\n      const created = ensured.created;\n      const scopeId = String(row.id);\n      if (!created && input.parentId != null && str(row.parentId) === undefined) {\n        // An unlinked scope takes its first parent; the conditional UPDATE keeps the first writer's link.\n        await this.#livePage(tx, input.parentId);\n        if (input.parentId === scopeId) throw new Error(`Scope ${scopeId} cannot be its own parent`);\n        let ancestor: string | undefined = input.parentId;\n        while (ancestor) {\n          const up = (await this.#pageRow(tx, ancestor))!;\n          if (String(up.id) === scopeId) throw new Error(`Scope ${scopeId} cannot be linked under its own descendant`);\n          ancestor = str(up.parentId);\n        }\n        await tx.execute({\n          sql: `UPDATE \"${T.pages}\" SET parentId = ?, position = ?, version = version + 1, updatedAt = ? WHERE id = ? AND parentId IS NULL`,\n          args: [\n            input.parentId,\n            core.knowledgePositionBetween(await this.#lastPosition(tx, input.parentId, true)),\n            now,\n            scopeId,\n          ],\n        });\n        row = (await this.#pageRow(tx, scopeId))!;\n      }\n      let parentConflict: MaterializeKnowledgeScopeResult['parentConflict'];\n      if (!created && input.parentId !== undefined && (str(row.parentId) ?? null) !== input.parentId) {\n        parentConflict = { existingParentId: str(row.parentId) ?? null, requestedParentId: input.parentId };\n      }\n      for (const child of input.children ?? []) await ensureScope(child, scopeId);\n      const ensureTemplates = async (\n        templates: NonNullable<MaterializeKnowledgeScopeInput['pages']>,\n        parentId: string,\n      ): Promise<void> => {\n        for (const template of templates) {\n          const problem = knowledgePageKeyProblem(template.key);\n          if (problem) throw new Error(problem);\n          const existing = (\n            await this.#query(\n              tx,\n              `SELECT id FROM \"${T.pages}\" WHERE parentId = ? AND isScope = 0 AND key = ? AND deletedAt IS NULL`,\n              [parentId, template.key],\n            )\n          )[0];\n          const id = existing\n            ? String(existing.id)\n            : (\n                await this.#insertPage(tx, {\n                  parentId,\n                  key: template.key,\n                  name: template.name,\n                  description: template.description,\n                  provenance: input.provenance,\n                })\n              ).id;\n          if (template.pages?.length) await ensureTemplates(template.pages, id);\n        }\n      };\n      await ensureTemplates(input.pages ?? [], scopeId);\n      return {\n        scope: toPage((await this.#pageRow(tx, scopeId))!),\n        created,\n        ...(parentConflict ? { parentConflict } : {}),\n      };\n    });\n  }\n\n  async listScopeDeclarations(): Promise<KnowledgeScopeDeclarationCount[]> {\n    const rows = await this.#query(\n      this.#read,\n      `SELECT declaration, COUNT(*) AS scopes FROM \"${T.pages}\" WHERE isScope = 1 AND declaration IS NOT NULL GROUP BY declaration ORDER BY declaration`,\n    );\n    return rows.map(row => ({ declaration: String(row.declaration), scopes: Number(row.scopes) }));\n  }\n\n  async renameScopeDeclaration(input: {\n    from: string;\n    to: string;\n    check: (scopes: KnowledgeScopeDeclarationRename[]) => void;\n  }): Promise<number> {\n    return this.#transaction(async tx => {\n      const within = prefixRange('declaration', `${input.from}/`);\n      const rows = await this.#query(\n        tx,\n        `SELECT id, address, declaration FROM \"${T.pages}\" WHERE isScope = 1 AND (declaration = ? OR ${within.sql})`,\n        [input.from, ...within.args],\n      );\n      // Collations may pad or fold; keep only exact, case-sensitive matches.\n      const affected = rows\n        .map(row => ({ id: String(row.id), address: String(row.address), from: String(row.declaration) }))\n        .filter(row => row.from === input.from || row.from.startsWith(`${input.from}/`))\n        .map(row => ({ ...row, to: input.to + row.from.slice(input.from.length) }));\n      input.check(affected.map(({ address, from, to }) => ({ address, from, to })));\n      for (const row of affected) {\n        await tx.execute({ sql: `UPDATE \"${T.pages}\" SET declaration = ? WHERE id = ?`, args: [row.to, row.id] });\n      }\n      return affected.length;\n    });\n  }\n\n  async getScopesByAddress(addresses: string[]): Promise<KnowledgePage[]> {\n    if (addresses.length === 0) return [];\n    const rows = await this.#query(\n      this.#read,\n      `SELECT * FROM \"${T.pages}\" WHERE isScope = 1 AND address IN (SELECT value FROM json_each(?))`,\n      [jsonList(addresses)],\n    );\n    return rows.map(toPage);\n  }\n\n  async listChildScopes(input: {\n    parentId: string | null;\n    read?: KnowledgeReadScope;\n    cursor?: string;\n    limit?: number;\n  }): Promise<KnowledgePageListOutput> {\n    const core = await loadPagesCore();\n    const limit = limitOf(input.limit, core.MAX_KNOWLEDGE_PAGE_LIST_LIMIT);\n    const cursor = decodeCursor(input.cursor, 2);\n    const args: InValue[] = [input.parentId];\n    let filter = '';\n    if (input.read) {\n      const readable = readableScopes(input.read);\n      filter = ` AND id IN (${readable.sql})`;\n      args.push(...readable.args);\n    }\n    let after = '';\n    if (cursor) {\n      after = ` AND (position > ? OR (position = ? AND id > ?))`;\n      args.push(cursor[0]!, cursor[0]!, cursor[1]!);\n    }\n    args.push(limit + 1);\n    const rows = await this.#query(\n      this.#read,\n      `SELECT * FROM \"${T.pages}\" WHERE isScope = 1 AND parentId IS ?${filter}${after} ORDER BY position, id LIMIT ?`,\n      args,\n    );\n    return this.#pageOutput(rows, limit, row => [String(row.position), String(row.id)]);\n  }\n\n  #pageOutput(rows: Row[], limit: number, cursorOf: (row: Row) => string[]): KnowledgePageListOutput {\n    const page = rows.slice(0, limit);\n    return {\n      pages: page.map(toPage),\n      ...(rows.length > limit ? { nextCursor: encodeCursor(cursorOf(page[page.length - 1]!)) } : {}),\n    };\n  }\n\n  // Pages\n\n  async getPage(input: { id: string; read: KnowledgeReadScope }): Promise<KnowledgePage | null> {\n    const readable = pageReadable('p', input.read);\n    const rows = await this.#query(this.#read, `SELECT p.* FROM \"${T.pages}\" p WHERE p.id = ? AND ${readable.sql}`, [\n      input.id,\n      ...readable.args,\n    ]);\n    return rows[0] ? toPage(rows[0]) : null;\n  }\n\n  async getPages(input: { ids: string[]; read: KnowledgeReadScope }): Promise<KnowledgePage[]> {\n    const ids = [...new Set(input.ids)];\n    if (ids.length === 0) return [];\n    const readable = pageReadable('p', input.read);\n    const rows = await this.#query(\n      this.#read,\n      `SELECT p.* FROM \"${T.pages}\" p WHERE p.deletedAt IS NULL AND p.id IN (SELECT value FROM json_each(?)) AND ${readable.sql}`,\n      [jsonList(ids), ...readable.args],\n    );\n    return rows.map(toPage);\n  }\n\n  async getPageByPath(input: {\n    scopeId: string;\n    path: string[];\n    read: KnowledgeReadScope;\n  }): Promise<KnowledgePage | null> {\n    const readable = pageReadable('p', input.read);\n    let parentId = input.scopeId;\n    let row: Row | undefined;\n    for (const key of input.path) {\n      row = (\n        await this.#query(\n          this.#read,\n          `SELECT p.* FROM \"${T.pages}\" p WHERE p.parentId = ? AND p.isScope = 0 AND p.key = ? AND p.deletedAt IS NULL AND ${readable.sql}`,\n          [parentId, key, ...readable.args],\n        )\n      )[0];\n      if (!row) return null;\n      parentId = String(row.id);\n    }\n    return row ? toPage(row) : null;\n  }\n\n  async findPagesByName(input: {\n    name: string;\n    read: KnowledgeReadScope;\n    scopeId?: string;\n    limit?: number;\n  }): Promise<KnowledgePage[]> {\n    const core = await loadPagesCore();\n    const readable = pageReadable('p', input.read);\n    const args: InValue[] = [core.canonicalKnowledgeName(input.name), ...readable.args];\n    let scope = '';\n    if (input.scopeId !== undefined) {\n      scope = ` AND p.scopeId = ?`;\n      args.push(input.scopeId);\n    }\n    args.push(limitOf(input.limit, core.MAX_KNOWLEDGE_PAGE_LIST_LIMIT));\n    const rows = await this.#query(\n      this.#read,\n      `SELECT p.* FROM \"${T.pages}\" p WHERE p.canonicalName = ? AND p.deletedAt IS NULL AND ${readable.sql}${scope} ORDER BY p.createdAt DESC, p.id DESC LIMIT ?`,\n      args,\n    );\n    return rows.map(toPage);\n  }\n\n  async listChildPages(input: {\n    parentId: string;\n    read: KnowledgeReadScope;\n    cursor?: string;\n    limit?: number;\n  }): Promise<KnowledgePageListOutput> {\n    const core = await loadPagesCore();\n    const limit = limitOf(input.limit, core.MAX_KNOWLEDGE_PAGE_LIST_LIMIT);\n    const cursor = decodeCursor(input.cursor, 2);\n    const readable = pageReadable('p', input.read);\n    const args: InValue[] = [input.parentId, ...readable.args];\n    let after = '';\n    if (cursor) {\n      after = ` AND (p.position > ? OR (p.position = ? AND p.id > ?))`;\n      args.push(cursor[0]!, cursor[0]!, cursor[1]!);\n    }\n    args.push(limit + 1);\n    const rows = await this.#query(\n      this.#read,\n      `SELECT p.* FROM \"${T.pages}\" p WHERE p.parentId = ? AND p.isScope = 0 AND p.deletedAt IS NULL AND ${readable.sql}${after} ORDER BY p.position, p.id LIMIT ?`,\n      args,\n    );\n    return this.#pageOutput(rows, limit, row => [String(row.position), String(row.id)]);\n  }\n\n  async listPages(input: {\n    read: KnowledgeReadScope;\n    scopeId?: string;\n    namePrefix?: string;\n    cursor?: string;\n    limit?: number;\n  }): Promise<KnowledgePageListOutput> {\n    const core = await loadPagesCore();\n    const limit = limitOf(input.limit, core.MAX_KNOWLEDGE_PAGE_LIST_LIMIT);\n    const cursor = decodeCursor(input.cursor, 2);\n    const readable = pageReadable('p', input.read);\n    const args: InValue[] = [...readable.args];\n    let filters = '';\n    if (input.scopeId !== undefined) {\n      filters += ` AND p.scopeId = ?`;\n      args.push(input.scopeId);\n    }\n    if (input.namePrefix) {\n      const prefix = core.canonicalKnowledgeName(input.namePrefix);\n      filters += ` AND substr(p.canonicalName, 1, length(?)) = ?`;\n      args.push(prefix, prefix);\n    }\n    if (cursor) {\n      filters += ` AND (p.name > ? OR (p.name = ? AND p.id > ?))`;\n      args.push(cursor[0]!, cursor[0]!, cursor[1]!);\n    }\n    args.push(limit + 1);\n    const rows = await this.#query(\n      this.#read,\n      `SELECT p.* FROM \"${T.pages}\" p WHERE p.isScope = 0 AND p.deletedAt IS NULL AND ${readable.sql}${filters} ORDER BY p.name, p.id LIMIT ?`,\n      args,\n    );\n    return this.#pageOutput(rows, limit, row => [String(row.name), String(row.id)]);\n  }\n\n  async #insertPage(tx: PageExecutor, input: CreateKnowledgePageInput): Promise<KnowledgePage> {\n    const core = await loadPagesCore();\n    await assertKnowledgePageDescriptionWithinBound(input.description);\n    const parent = await this.#livePage(tx, input.parentId);\n    const isScopeParent = Number(parent.isScope) === 1;\n    const scopeId = isScopeParent ? String(parent.id) : String(parent.scopeId);\n    const depth = isScopeParent ? 1 : Number(parent.depth) + 1;\n    if (depth > core.MAX_KNOWLEDGE_PAGE_DEPTH) throw new core.KnowledgePageDepthError(input.parentId);\n    const id = input.id ?? createKnowledgeUlid();\n    if (await this.#pageRow(tx, id)) throw new KnowledgeConflictError(id);\n    if (input.key !== undefined) {\n      const problem = knowledgePageKeyProblem(input.key);\n      if (problem) throw new Error(problem);\n      const clash = await this.#query(\n        tx,\n        `SELECT id FROM \"${T.pages}\" WHERE parentId = ? AND isScope = 0 AND key = ? AND deletedAt IS NULL`,\n        [String(parent.id), input.key],\n      );\n      if (clash.length > 0) throw new core.KnowledgePageKeyConflictError(input.key, String(parent.id));\n    }\n    const position =\n      input.position ?? core.knowledgePositionBetween(await this.#lastPosition(tx, String(parent.id), false));\n    const now = new Date().toISOString();\n    const who = JSON.stringify(input.provenance);\n    await tx.execute({\n      sql: `INSERT INTO \"${T.pages}\" (id, scopeId, isScope, key, parentId, position, path, depth, name, canonicalName, description, body, version, createdBy, updatedBy, createdAt, updatedAt) VALUES (?, ?, 0, ?, ?, ?, ?, ?, ?, ?, ?, ?, 1, ?, ?, ?, ?)`,\n      args: [\n        id,\n        scopeId,\n        input.key ?? null,\n        String(parent.id),\n        position,\n        `${String(parent.path)}${id}/`,\n        depth,\n        input.name,\n        core.canonicalKnowledgeName(input.name),\n        input.description || null,\n        input.body ?? null,\n        who,\n        who,\n        now,\n        now,\n      ],\n    });\n    await this.#logActivity(tx, 'page-created', { scopeId, pageId: id, provenance: input.provenance }, now);\n    return toPage((await this.#pageRow(tx, id))!);\n  }\n\n  async createPage(input: CreateKnowledgePageInput): Promise<KnowledgePage> {\n    await assertKnowledgePageDescriptionWithinBound(input.description);\n    return this.#transaction(tx => this.#insertPage(tx, input));\n  }\n\n  async updatePage(input: UpdateKnowledgePageInput): Promise<KnowledgePage> {\n    const core = await loadPagesCore();\n    await assertKnowledgePageDescriptionWithinBound(input.description);\n    return this.#transaction(async tx => {\n      const row = await this.#livePage(tx, input.id);\n      if (Number(row.version) !== input.expectedVersion) throw new KnowledgeConflictError(input.id);\n      const now = new Date().toISOString();\n      const name = input.name ?? String(row.name);\n      const description = input.description === undefined ? (row.description ?? null) : input.description || null;\n      const body = input.body === undefined ? (row.body ?? null) : input.body;\n      await tx.execute({\n        sql: `UPDATE \"${T.pages}\" SET name = ?, canonicalName = ?, description = ?, body = ?, version = version + 1, updatedBy = ?, updatedAt = ? WHERE id = ?`,\n        args: [\n          name,\n          core.canonicalKnowledgeName(name),\n          description as InValue,\n          body as InValue,\n          JSON.stringify(input.provenance),\n          now,\n          input.id,\n        ],\n      });\n      await this.#logActivity(\n        tx,\n        'page-updated',\n        { scopeId: String(row.scopeId), pageId: input.id, provenance: input.provenance },\n        now,\n      );\n      return toPage((await this.#pageRow(tx, input.id))!);\n    });\n  }\n\n  /**\n   * Rehomes `root` (and its subtree) under `parent`: new path prefix, scope and depth in one go.\n   * Throws when the subtree is too large, too deep, or the root's key clashes with a live child of `parent`.\n   */\n  async #rehome(\n    tx: PageExecutor,\n    root: Row,\n    parent: Row,\n    options: { position?: string; countLimitId: string; skipRootCount?: boolean },\n  ): Promise<{ moved: number; scopeId: string }> {\n    const core = await loadPagesCore();\n    const isScopeParent = Number(parent.isScope) === 1;\n    const newScopeId = isScopeParent ? String(parent.id) : String(parent.scopeId);\n    const newDepth = isScopeParent ? 1 : Number(parent.depth) + 1;\n    const oldPath = String(root.path);\n    const within = prefixRange('path', oldPath);\n    const subtree = await this.#query(\n      tx,\n      `SELECT id, key, depth, deletedAt FROM \"${T.pages}\" WHERE ${within.sql}`,\n      within.args,\n    );\n    const live = subtree.filter(row => !row.deletedAt);\n    if (live.length > core.MAX_KNOWLEDGE_MOVE_PAGES)\n      throw new core.KnowledgeMoveTooLargeError(options.countLimitId, live.length);\n    const shift = newDepth - Number(root.depth);\n    const deepest = Math.max(...live.map(row => Number(row.depth)));\n    if (deepest + shift > core.MAX_KNOWLEDGE_PAGE_DEPTH) throw new core.KnowledgePageDepthError(String(root.id));\n    if (!root.deletedAt && root.key !== null) {\n      const clash = await this.#query(\n        tx,\n        `SELECT id FROM \"${T.pages}\" WHERE parentId = ? AND isScope = 0 AND key = ? AND deletedAt IS NULL AND id <> ?`,\n        [String(parent.id), String(root.key), String(root.id)],\n      );\n      if (clash.length > 0) throw new core.KnowledgePageKeyConflictError(String(root.key), String(parent.id));\n    }\n    const newPath = `${String(parent.path)}${String(root.id)}/`;\n    const position =\n      options.position ?? core.knowledgePositionBetween(await this.#lastPosition(tx, String(parent.id), false));\n    await tx.execute({\n      sql: `UPDATE \"${T.pages}\" SET path = ? || substr(path, length(?) + 1), depth = depth + ?, scopeId = ? WHERE ${within.sql}`,\n      args: [newPath, oldPath, shift, newScopeId, ...within.args],\n    });\n    await tx.execute({\n      sql: `UPDATE \"${T.pages}\" SET parentId = ?, position = ? WHERE id = ?`,\n      args: [String(parent.id), position, String(root.id)],\n    });\n    return { moved: live.length, scopeId: newScopeId };\n  }\n\n  movePage(input: MoveKnowledgePageInput): Promise<KnowledgePage> {\n    return this.#transaction(async tx => {\n      const row = await this.#livePage(tx, input.id);\n      if (Number(row.isScope) === 1) throw new Error(`Cannot move ${input.id}: it is a scope page`);\n      if (Number(row.version) !== input.expectedVersion) throw new KnowledgeConflictError(input.id);\n      const parent = await this.#livePage(tx, input.parentId);\n      const path = String(row.path);\n      if (String(parent.id) === input.id || String(parent.path).startsWith(path)) {\n        throw new Error(`Cannot move ${input.id} into its own subtree`);\n      }\n      const now = new Date().toISOString();\n      const { scopeId } = await this.#rehome(tx, row, parent, {\n        position: input.position,\n        countLimitId: input.id,\n      });\n      await tx.execute({\n        sql: `UPDATE \"${T.pages}\" SET version = version + 1, updatedBy = ?, updatedAt = ? WHERE id = ?`,\n        args: [JSON.stringify(input.provenance), now, input.id],\n      });\n      await this.#logActivity(tx, 'page-moved', { scopeId, pageId: input.id, provenance: input.provenance }, now);\n      return toPage((await this.#pageRow(tx, input.id))!);\n    });\n  }\n\n  async mergePages(input: MergeKnowledgePagesInput): Promise<KnowledgePage> {\n    const core = await loadPagesCore();\n    return this.#transaction(async tx => {\n      const source = await this.#livePage(tx, input.sourceId);\n      const target = await this.#livePage(tx, input.targetId);\n      if (Number(source.isScope) === 1 || Number(target.isScope) === 1) {\n        throw new Error('Cannot merge a scope page: merging applies to non-scope pages only');\n      }\n      if (Number(source.version) !== input.sourceVersion) throw new KnowledgeConflictError(input.sourceId);\n      const sourcePath = String(source.path);\n      if (input.sourceId === input.targetId || String(target.path).startsWith(sourcePath)) {\n        throw new Error(\n          `Page ${input.targetId} is inside page ${input.sourceId}; it cannot be the merge target (subtree)`,\n        );\n      }\n      const within = prefixRange('path', sourcePath);\n      const carried = await this.#query(\n        tx,\n        `SELECT COUNT(*) AS n FROM \"${T.pages}\" WHERE ${within.sql} AND id <> ? AND deletedAt IS NULL`,\n        [...within.args, input.sourceId],\n      );\n      if (Number(carried[0]!.n) > core.MAX_KNOWLEDGE_MOVE_PAGES) {\n        throw new core.KnowledgeMoveTooLargeError(input.sourceId, Number(carried[0]!.n));\n      }\n      const now = new Date().toISOString();\n      // The source goes first so its own key never clashes with a child that takes the same parent.\n      await tx.execute({\n        sql: `UPDATE \"${T.pages}\" SET deletedAt = ?, deletedBy = ?, mergedInto = ?, scopeId = ?, version = version + 1, updatedBy = ?, updatedAt = ? WHERE id = ?`,\n        args: [\n          now,\n          input.provenance.author,\n          input.targetId,\n          String(target.scopeId),\n          JSON.stringify(input.provenance),\n          now,\n          input.sourceId,\n        ],\n      });\n      const children = await this.#query(tx, `SELECT * FROM \"${T.pages}\" WHERE parentId = ? AND isScope = 0`, [\n        input.sourceId,\n      ]);\n      for (const child of children) {\n        await this.#rehome(tx, child, target, {\n          position: String(child.position),\n          countLimitId: input.sourceId,\n        });\n      }\n      await tx.execute({\n        sql: `UPDATE \"${T.notes}\" SET pageId = ? WHERE pageId = ?`,\n        args: [input.targetId, input.sourceId],\n      });\n      await tx.execute({\n        sql: `UPDATE OR IGNORE \"${T.mentions}\" SET pageId = ? WHERE pageId = ?`,\n        args: [input.targetId, input.sourceId],\n      });\n      await tx.execute({ sql: `DELETE FROM \"${T.mentions}\" WHERE pageId = ?`, args: [input.sourceId] });\n      const pins = await this.#query(tx, `SELECT * FROM \"${T.pins}\" WHERE pageId IN (?, ?)`, [\n        input.sourceId,\n        input.targetId,\n      ]);\n      for (const sourcePin of pins.filter(pin => String(pin.pageId) === input.sourceId)) {\n        const targetPin = pins.find(pin => String(pin.pageId) === input.targetId && pin.kind === sourcePin.kind);\n        const audience = JSON.parse(String(sourcePin.audience)) as string[];\n        if (targetPin) {\n          const merged = [...new Set([...(JSON.parse(String(targetPin.audience)) as string[]), ...audience])];\n          await tx.execute({\n            sql: `UPDATE \"${T.pins}\" SET audience = ?, updatedAt = ? WHERE id = ?`,\n            args: [JSON.stringify(merged), now, String(targetPin.id)],\n          });\n          await this.#indexAudience(tx, String(targetPin.id), merged);\n          await this.#indexAudience(tx, String(sourcePin.id), []);\n          await tx.execute({ sql: `DELETE FROM \"${T.pins}\" WHERE id = ?`, args: [String(sourcePin.id)] });\n        } else {\n          await tx.execute({\n            sql: `UPDATE \"${T.pins}\" SET pageId = ?, updatedAt = ? WHERE id = ?`,\n            args: [input.targetId, now, String(sourcePin.id)],\n          });\n        }\n      }\n      await this.#logActivity(\n        tx,\n        'page-merged',\n        { scopeId: String(target.scopeId), pageId: input.sourceId, provenance: input.provenance },\n        now,\n      );\n      return toPage((await this.#pageRow(tx, input.targetId))!);\n    });\n  }\n\n  async deletePage(input: { id: string; expectedVersion: number; deletedBy: string }): Promise<KnowledgePage> {\n    const core = await loadPagesCore();\n    return this.#transaction(async tx => {\n      const row = await this.#livePage(tx, input.id);\n      if (Number(row.isScope) === 1) throw new Error(`Cannot delete ${input.id}: it is a scope page`);\n      if (Number(row.version) !== input.expectedVersion) throw new KnowledgeConflictError(input.id);\n      const children = await this.#query(\n        tx,\n        `SELECT 1 FROM \"${T.pages}\" WHERE parentId = ? AND deletedAt IS NULL LIMIT 1`,\n        [input.id],\n      );\n      if (children.length > 0) throw new core.KnowledgePageHasChildrenError(input.id);\n      const now = new Date().toISOString();\n      await tx.execute({\n        sql: `UPDATE \"${T.pages}\" SET deletedAt = ?, deletedBy = ?, version = version + 1, updatedBy = ?, updatedAt = ? WHERE id = ?`,\n        args: [now, input.deletedBy, JSON.stringify({ author: input.deletedBy }), now, input.id],\n      });\n      await tx.execute({\n        sql: `DELETE FROM \"${T.pinAudiences}\" WHERE pinId IN (SELECT id FROM \"${T.pins}\" WHERE pageId = ?)`,\n        args: [input.id],\n      });\n      await tx.execute({ sql: `DELETE FROM \"${T.pins}\" WHERE pageId = ?`, args: [input.id] });\n      await this.#logActivity(\n        tx,\n        'page-deleted',\n        { scopeId: String(row.scopeId), pageId: input.id, provenance: { author: input.deletedBy } },\n        now,\n      );\n      return toPage((await this.#pageRow(tx, input.id))!);\n    });\n  }\n\n  // Notes\n\n  async #hydrateNotes(executor: PageExecutor, rows: Row[]): Promise<KnowledgeNote[]> {\n    if (rows.length === 0) return [];\n    const ids = jsonList(rows.map(row => String(row.id)));\n    const stamps = await this.#query(\n      executor,\n      `SELECT noteId, scopeId FROM \"${T.stamps}\" WHERE noteId IN (SELECT value FROM json_each(?)) ORDER BY scopeId`,\n      [ids],\n    );\n    const mentions = await this.#query(\n      executor,\n      `SELECT noteId, pageId FROM \"${T.mentions}\" WHERE noteId IN (SELECT value FROM json_each(?)) ORDER BY pageId`,\n      [ids],\n    );\n    return rows.map(row =>\n      toNote(\n        row,\n        stamps.filter(stamp => String(stamp.noteId) === String(row.id)).map(stamp => String(stamp.scopeId)),\n        mentions.filter(mention => String(mention.noteId) === String(row.id)).map(mention => String(mention.pageId)),\n      ),\n    );\n  }\n\n  async #noteById(executor: PageExecutor, id: string): Promise<KnowledgeNote | null> {\n    const rows = await this.#query(executor, `SELECT * FROM \"${T.notes}\" WHERE id = ?`, [id]);\n    return (await this.#hydrateNotes(executor, rows))[0] ?? null;\n  }\n\n  async getNote(input: {\n    id: string;\n    read: KnowledgeReadScope;\n    includeDeleted?: boolean;\n  }): Promise<KnowledgeNote | null> {\n    const readable = noteReadable('n', input.read);\n    const rows = await this.#query(\n      this.#read,\n      `SELECT n.* FROM \"${T.notes}\" n WHERE n.id = ?${input.includeDeleted ? '' : ' AND n.deletedAt IS NULL'} AND ${readable.sql}`,\n      [input.id, ...readable.args],\n    );\n    return (await this.#hydrateNotes(this.#read, rows))[0] ?? null;\n  }\n\n  async listNotes(input: {\n    pageId: string;\n    read: KnowledgeReadScope;\n    cursor?: string;\n    limit?: number;\n    includeDeleted?: boolean;\n  }): Promise<KnowledgeNoteListOutput> {\n    const core = await loadPagesCore();\n    const limit = limitOf(input.limit, core.MAX_KNOWLEDGE_PAGE_LIST_LIMIT);\n    const cursor = decodeCursor(input.cursor, 2);\n    const readable = noteReadable('n', input.read);\n    const args: InValue[] = [input.pageId, ...readable.args];\n    let after = '';\n    if (cursor) {\n      after = ` AND (n.createdAt > ? OR (n.createdAt = ? AND n.id > ?))`;\n      args.push(cursor[0]!, cursor[0]!, cursor[1]!);\n    }\n    args.push(limit + 1);\n    const rows = await this.#query(\n      this.#read,\n      `SELECT n.* FROM \"${T.notes}\" n WHERE n.pageId = ?${input.includeDeleted ? '' : ' AND n.deletedAt IS NULL'} AND ${readable.sql}${after} ORDER BY n.createdAt, n.id LIMIT ?`,\n      args,\n    );\n    return this.#noteOutput(rows, limit);\n  }\n\n  async countChildScopes(input: { parentIds: string[]; read: KnowledgeReadScope }): Promise<Record<string, number>> {\n    const ids = [...new Set(input.parentIds)];\n    const counts: Record<string, number> = Object.fromEntries(ids.map(id => [id, 0]));\n    if (ids.length === 0) return counts;\n    const readable = readableScopes(input.read);\n    const rows = await this.#query(\n      this.#read,\n      `SELECT parentId, COUNT(*) AS total FROM \"${T.pages}\" WHERE parentId IN (SELECT value FROM json_each(?)) AND isScope = 1 AND id IN (${readable.sql}) GROUP BY parentId`,\n      [jsonList(ids), ...readable.args],\n    );\n    for (const row of rows) counts[String(row.parentId)] = Number(row.total);\n    return counts;\n  }\n\n  async countChildPages(input: { parentIds: string[]; read: KnowledgeReadScope }): Promise<Record<string, number>> {\n    const ids = [...new Set(input.parentIds)];\n    const counts: Record<string, number> = Object.fromEntries(ids.map(id => [id, 0]));\n    if (ids.length === 0) return counts;\n    const readable = pageReadable('p', input.read);\n    const rows = await this.#query(\n      this.#read,\n      `SELECT p.parentId AS parentId, COUNT(*) AS total FROM \"${T.pages}\" p WHERE p.parentId IN (SELECT value FROM json_each(?)) AND p.isScope = 0 AND p.deletedAt IS NULL AND ${readable.sql} GROUP BY p.parentId`,\n      [jsonList(ids), ...readable.args],\n    );\n    for (const row of rows) counts[String(row.parentId)] = Number(row.total);\n    return counts;\n  }\n\n  async replacePageBodyLinks(input: Parameters<KnowledgePageStore['replacePageBodyLinks']>[0]): Promise<void> {\n    await this.#transaction(async tx => {\n      await tx.execute({ sql: `DELETE FROM \"${T.links}\" WHERE fromPageId = ?`, args: [input.pageId] });\n      if (input.links.length === 0) return;\n      await tx.execute({\n        sql: `INSERT INTO \"${T.links}\" (fromPageId, ref, toPageId, count) SELECT ?, json_extract(value, '$.ref'), json_extract(value, '$.toPageId'), json_extract(value, '$.count') FROM json_each(?)`,\n        args: [input.pageId, JSON.stringify(input.links.map(({ ref, toPageId, count }) => ({ ref, toPageId, count })))],\n      });\n    });\n  }\n\n  async listPageBodyLinkSources(\n    input: Parameters<KnowledgePageStore['listPageBodyLinkSources']>[0],\n  ): Promise<string[]> {\n    const refs = input.refs ?? [];\n    const targets = input.toPageIds ?? [];\n    if (refs.length === 0 && targets.length === 0) return [];\n    const rows = await this.#query(\n      this.#read,\n      `SELECT DISTINCT fromPageId FROM \"${T.links}\" WHERE (toPageId IS NULL AND ref IN (SELECT value FROM json_each(?))) OR toPageId IN (SELECT value FROM json_each(?)) ORDER BY fromPageId`,\n      [jsonList(refs), jsonList(targets)],\n    );\n    return rows.map(row => String(row.fromPageId));\n  }\n\n  /**\n   * Visible links touching `ids` (from them for `out`, to them for `in`): resolved, both ends live\n   * and readable, not self-links; a note link also needs a visible live note. One row per\n   * (from, to, kind), counts summed.\n   */\n  async #links(\n    read: KnowledgeReadScope,\n    kinds: Parameters<KnowledgePageStore['listPageLinks']>[0]['kinds'],\n    ids: string[],\n    direction: 'in' | 'out' | 'both',\n  ): Promise<Row[]> {\n    const wanted = new Set(kinds ?? ['body', 'note']);\n    const touches = (from: string, to: string): Fragment => {\n      const parts: string[] = [];\n      const args: InValue[] = [];\n      if (direction !== 'in') {\n        parts.push(`${from} IN (SELECT value FROM json_each(?))`);\n        args.push(jsonList(ids));\n      }\n      if (direction !== 'out') {\n        parts.push(`${to} IN (SELECT value FROM json_each(?))`);\n        args.push(jsonList(ids));\n      }\n      return { sql: `(${parts.join(' OR ')})`, args };\n    };\n    const sources: string[] = [];\n    const args: InValue[] = [];\n    if (wanted.has('body')) {\n      const near = touches('l.fromPageId', 'l.toPageId');\n      sources.push(\n        `SELECT l.fromPageId AS fromPageId, l.toPageId AS toPageId, 'body' AS kind, l.count AS count FROM \"${T.links}\" l WHERE l.toPageId IS NOT NULL AND ${near.sql}`,\n      );\n      args.push(...near.args);\n    }\n    if (wanted.has('note')) {\n      const near = touches('n.pageId', 'm.pageId');\n      const visible = noteReadable('n', read);\n      sources.push(\n        `SELECT n.pageId AS fromPageId, m.pageId AS toPageId, 'note' AS kind, 1 AS count FROM \"${T.mentions}\" m JOIN \"${T.notes}\" n ON n.id = m.noteId WHERE n.deletedAt IS NULL AND ${near.sql} AND ${visible.sql}`,\n      );\n      args.push(...near.args, ...visible.args);\n    }\n    if (sources.length === 0) return [];\n    const fromReadable = pageReadable('fp', read);\n    const toReadable = pageReadable('tp', read);\n    return this.#query(\n      this.#read,\n      `SELECT e.fromPageId AS fromPageId, e.toPageId AS toPageId, e.kind AS kind, SUM(e.count) AS count\n        FROM (${sources.join(' UNION ALL ')}) e\n        JOIN \"${T.pages}\" fp ON fp.id = e.fromPageId AND fp.deletedAt IS NULL AND ${fromReadable.sql}\n        JOIN \"${T.pages}\" tp ON tp.id = e.toPageId AND tp.deletedAt IS NULL AND ${toReadable.sql}\n        WHERE e.fromPageId <> e.toPageId\n        GROUP BY e.fromPageId, e.toPageId, e.kind\n        ORDER BY e.fromPageId, e.toPageId, CASE e.kind WHEN 'body' THEN 0 ELSE 1 END`,\n      [...args, ...fromReadable.args, ...toReadable.args],\n    );\n  }\n\n  async countPageLinks(\n    input: Parameters<KnowledgePageStore['countPageLinks']>[0],\n  ): Promise<Record<string, { in: number; out: number }>> {\n    const ids = [...new Set(input.pageIds)];\n    const linked = new Map(ids.map(id => [id, { in: new Set<string>(), out: new Set<string>() }]));\n    if (ids.length === 0) return {};\n    for (const row of await this.#links(input.read, input.kinds, ids, 'both')) {\n      const from = String(row.fromPageId);\n      const to = String(row.toPageId);\n      linked.get(from)?.out.add(to);\n      linked.get(to)?.in.add(from);\n    }\n    return Object.fromEntries([...linked].map(([id, sets]) => [id, { in: sets.in.size, out: sets.out.size }]));\n  }\n\n  async listPageLinks(\n    input: Parameters<KnowledgePageStore['listPageLinks']>[0],\n  ): ReturnType<KnowledgePageStore['listPageLinks']> {\n    const limit = input.limit ?? 1_000;\n    if (!Number.isInteger(limit) || limit < 1) throw new RangeError('Knowledge link limit must be a positive integer');\n    const ids = [...new Set(input.pageIds)];\n    if (ids.length === 0) return [];\n    const core = await loadPagesCore();\n    const rows = await this.#links(input.read, input.kinds, ids, input.direction ?? 'both');\n    return rows.slice(0, Math.min(limit, core.MAX_KNOWLEDGE_PAGE_LINKS)).map(row => ({\n      fromPageId: String(row.fromPageId),\n      toPageId: String(row.toPageId),\n      kind: row.kind === 'note' ? 'note' : 'body',\n      count: Number(row.count),\n    }));\n  }\n\n  async countNotes(input: { pageIds: string[]; read: KnowledgeReadScope }): Promise<Record<string, number>> {\n    const ids = [...new Set(input.pageIds)];\n    const counts: Record<string, number> = Object.fromEntries(ids.map(id => [id, 0]));\n    if (ids.length === 0) return counts;\n    const readable = noteReadable('n', input.read);\n    const rows = await this.#query(\n      this.#read,\n      `SELECT n.pageId AS pageId, COUNT(*) AS total FROM \"${T.notes}\" n WHERE n.pageId IN (SELECT value FROM json_each(?)) AND n.deletedAt IS NULL AND ${readable.sql} GROUP BY n.pageId`,\n      [jsonList(ids), ...readable.args],\n    );\n    for (const row of rows) counts[String(row.pageId)] = Number(row.total);\n    return counts;\n  }\n\n  async listNotesMentioning(input: {\n    pageId: string;\n    read: KnowledgeReadScope;\n    cursor?: string;\n    limit?: number;\n  }): Promise<KnowledgeNoteListOutput> {\n    const core = await loadPagesCore();\n    const limit = limitOf(input.limit, core.MAX_KNOWLEDGE_PAGE_LIST_LIMIT);\n    const cursor = decodeCursor(input.cursor, 2);\n    const readable = noteReadable('n', input.read);\n    const args: InValue[] = [input.pageId, input.pageId, ...readable.args];\n    let after = '';\n    if (cursor) {\n      after = ` AND (n.createdAt < ? OR (n.createdAt = ? AND n.id < ?))`;\n      args.push(cursor[0]!, cursor[0]!, cursor[1]!);\n    }\n    args.push(limit + 1);\n    const rows = await this.#query(\n      this.#read,\n      `SELECT n.* FROM \"${T.notes}\" n WHERE n.pageId <> ? AND n.deletedAt IS NULL AND EXISTS (SELECT 1 FROM \"${T.mentions}\" m WHERE m.noteId = n.id AND m.pageId = ?) AND ${readable.sql}${after} ORDER BY n.createdAt DESC, n.id DESC LIMIT ?`,\n      args,\n    );\n    return this.#noteOutput(rows, limit);\n  }\n\n  async #noteOutput(rows: Row[], limit: number): Promise<KnowledgeNoteListOutput> {\n    const page = rows.slice(0, limit);\n    return {\n      notes: await this.#hydrateNotes(this.#read, page),\n      ...(rows.length > limit\n        ? { nextCursor: encodeCursor([String(page[page.length - 1]!.createdAt), String(page[page.length - 1]!.id)]) }\n        : {}),\n    };\n  }\n\n  async #assertScopes(tx: PageExecutor, ids: string[]): Promise<void> {\n    if (ids.length === 0) throw new Error('A note needs at least one stamp scope');\n    const found = await this.#query(\n      tx,\n      `SELECT id FROM \"${T.pages}\" WHERE isScope = 1 AND id IN (SELECT value FROM json_each(?))`,\n      [jsonList(ids)],\n    );\n    const known = new Set(found.map(row => String(row.id)));\n    const missing = ids.find(id => !known.has(id));\n    if (missing) throw new Error(`Note stamp ${missing} is not a scope page`);\n  }\n\n  async addNote(input: AddKnowledgeNoteInput): Promise<KnowledgeNote> {\n    await assertKnowledgeNoteTextWithinBound(input.text);\n    return this.#transaction(async tx => {\n      const page = await this.#livePage(tx, input.pageId);\n      const stamps = [...new Set(input.stampScopeIds)];\n      await this.#assertScopes(tx, stamps);\n      const mentions = [...new Set(input.mentions)];\n      for (const mention of mentions) await this.#livePage(tx, mention);\n      const id = input.id ?? createKnowledgeUlid();\n      if ((await this.#query(tx, `SELECT 1 FROM \"${T.notes}\" WHERE id = ?`, [id])).length > 0) {\n        throw new KnowledgeConflictError(id);\n      }\n      const now = new Date().toISOString();\n      await tx.execute({\n        sql: `INSERT INTO \"${T.notes}\" (id, pageId, text, \"when\", provenance, version, createdAt, updatedAt) VALUES (?, ?, ?, ?, ?, 1, ?, ?)`,\n        args: [\n          id,\n          input.pageId,\n          input.text,\n          input.when ? input.when.toISOString() : null,\n          JSON.stringify(input.provenance),\n          now,\n          now,\n        ],\n      });\n      for (const stamp of stamps) {\n        await tx.execute({ sql: `INSERT INTO \"${T.stamps}\" (noteId, scopeId) VALUES (?, ?)`, args: [id, stamp] });\n      }\n      for (const mention of mentions) {\n        await tx.execute({ sql: `INSERT INTO \"${T.mentions}\" (noteId, pageId) VALUES (?, ?)`, args: [id, mention] });\n      }\n      await this.#logActivity(\n        tx,\n        'note-added',\n        { scopeId: String(page.scopeId), pageId: input.pageId, noteId: id, provenance: input.provenance },\n        now,\n      );\n      return (await this.#noteById(tx, id))!;\n    });\n  }\n\n  async #noteWithPage(tx: PageExecutor, id: string): Promise<{ note: Row; page: Row }> {\n    const note = (await this.#query(tx, `SELECT * FROM \"${T.notes}\" WHERE id = ?`, [id]))[0];\n    if (!note) throw new KnowledgeNotFoundError('note', id);\n    const page = await this.#pageRow(tx, String(note.pageId));\n    if (!page) throw new KnowledgeNotFoundError('page', String(note.pageId));\n    return { note, page };\n  }\n\n  restampNote(input: {\n    id: string;\n    expectedVersion: number;\n    stampScopeIds: string[];\n    provenance: KnowledgeProvenance;\n  }): Promise<KnowledgeNote> {\n    return this.#transaction(async tx => {\n      const { note, page } = await this.#noteWithPage(tx, input.id);\n      if (note.deletedAt) throw new KnowledgeNotFoundError('note', input.id);\n      if (Number(note.version) !== input.expectedVersion) throw new KnowledgeConflictError(input.id);\n      const stamps = [...new Set(input.stampScopeIds)];\n      await this.#assertScopes(tx, stamps);\n      const now = new Date().toISOString();\n      await tx.execute({ sql: `DELETE FROM \"${T.stamps}\" WHERE noteId = ?`, args: [input.id] });\n      for (const stamp of stamps) {\n        await tx.execute({ sql: `INSERT INTO \"${T.stamps}\" (noteId, scopeId) VALUES (?, ?)`, args: [input.id, stamp] });\n      }\n      await tx.execute({\n        sql: `UPDATE \"${T.notes}\" SET version = version + 1, updatedAt = ? WHERE id = ?`,\n        args: [now, input.id],\n      });\n      await this.#logActivity(\n        tx,\n        'note-restamped',\n        { scopeId: String(page.scopeId), pageId: String(page.id), noteId: input.id, provenance: input.provenance },\n        now,\n      );\n      return (await this.#noteById(tx, input.id))!;\n    });\n  }\n\n  removeNote(input: { id: string; deletedBy: string; provenance: KnowledgeProvenance }): Promise<KnowledgeNote> {\n    return this.#transaction(async tx => {\n      const { note, page } = await this.#noteWithPage(tx, input.id);\n      if (note.deletedAt) throw new KnowledgeNotFoundError('note', input.id);\n      const now = new Date().toISOString();\n      await tx.execute({\n        sql: `UPDATE \"${T.notes}\" SET deletedAt = ?, deletedBy = ?, version = version + 1, updatedAt = ? WHERE id = ?`,\n        args: [now, input.deletedBy, now, input.id],\n      });\n      await this.#logActivity(\n        tx,\n        'note-removed',\n        { scopeId: String(page.scopeId), pageId: String(page.id), noteId: input.id, provenance: input.provenance },\n        now,\n      );\n      return (await this.#noteById(tx, input.id))!;\n    });\n  }\n\n  restoreNote(input: { id: string; provenance: KnowledgeProvenance }): Promise<KnowledgeNote> {\n    return this.#transaction(async tx => {\n      const { note, page } = await this.#noteWithPage(tx, input.id);\n      if (!note.deletedAt) throw new KnowledgeNotFoundError('note', input.id);\n      const now = new Date().toISOString();\n      await tx.execute({\n        sql: `UPDATE \"${T.notes}\" SET deletedAt = NULL, deletedBy = NULL, version = version + 1, updatedAt = ? WHERE id = ?`,\n        args: [now, input.id],\n      });\n      await this.#logActivity(\n        tx,\n        'note-restored',\n        { scopeId: String(page.scopeId), pageId: String(page.id), noteId: input.id, provenance: input.provenance },\n        now,\n      );\n      return (await this.#noteById(tx, input.id))!;\n    });\n  }\n\n  // Search and activity\n\n  async searchPages(input: SearchKnowledgePagesInput): Promise<KnowledgePageSearchHit[]> {\n    const words = knowledgeSearchWords(input.query);\n    if (!words.length) return [];\n    const phrase = input.query.trim().toLowerCase().replace(/\\s+/g, ' ');\n    const limit = Math.max(1, input.limit ?? 20);\n    const likes = words.map(word => `%${escapeLike(word)}%`);\n    const readable = pageReadable('p', input.read);\n    const scopeFilter = input.scopeIds ? ` AND p.scopeId IN (SELECT value FROM json_each(?))` : '';\n    const scopeArgs: InValue[] = input.scopeIds ? [jsonList(input.scopeIds)] : [];\n    const field = (column: string) => `lower(COALESCE(${column}, '')) LIKE ? ESCAPE '='`;\n    const pageMatch = words\n      .map(() => `(${field('p.name')} OR ${field('p.description')} OR ${field('p.body')})`)\n      .join(' OR ');\n    const pageScore = words\n      .map(\n        () =>\n          `(CASE WHEN ${field('p.name')} THEN ${KNOWLEDGE_SEARCH_WEIGHTS.name} WHEN ${field('p.description')} THEN ${KNOWLEDGE_SEARCH_WEIGHTS.description} WHEN ${field('p.body')} THEN ${KNOWLEDGE_SEARCH_WEIGHTS.body} ELSE 0 END)`,\n      )\n      .join(' + ');\n    const pageCount = words\n      .map(() => `(CASE WHEN ${field('p.name')} OR ${field('p.description')} OR ${field('p.body')} THEN 1 ELSE 0 END)`)\n      .join(' + ');\n    const triple = likes.flatMap(like => [like, like, like]);\n    const pageRows = await this.#query(\n      this.#read,\n      `SELECT p.* FROM \"${T.pages}\" p WHERE p.deletedAt IS NULL AND p.isScope = 0 AND ${readable.sql}${scopeFilter} AND (${pageMatch}) ORDER BY CASE WHEN instr(p.canonicalName, ?) > 0 THEN 0 ELSE 1 END, (${pageCount}) DESC, (${pageScore}) DESC, p.updatedAt DESC, p.id ASC LIMIT ?`,\n      [...readable.args, ...scopeArgs, ...triple, phrase, ...triple, ...triple, limit],\n    );\n    const hits: KnowledgePageSearchHit[] = pageRows.map(row => ({ type: 'page', page: toPage(row) }));\n    if (hits.length >= limit) return hits;\n    const noteVisible = noteReadable('n', input.read);\n    const noteHas = words.map(() => `lower(n.text) LIKE ? ESCAPE '='`);\n    const noteRows = await this.#query(\n      this.#read,\n      `SELECT n.* FROM \"${T.notes}\" n JOIN \"${T.pages}\" p ON p.id = n.pageId WHERE n.deletedAt IS NULL AND p.deletedAt IS NULL${scopeFilter} AND (${noteHas.join(' OR ')}) AND ${noteVisible.sql} ORDER BY (${noteHas.map(has => `(CASE WHEN ${has} THEN 1 ELSE 0 END)`).join(' + ')}) DESC, n.updatedAt DESC, n.id DESC LIMIT ?`,\n      [...scopeArgs, ...likes, ...noteVisible.args, ...likes, limit - hits.length],\n    );\n    const notes = await this.#hydrateNotes(this.#read, noteRows);\n    for (const note of notes) {\n      const page = await this.#pageRow(this.#read, note.pageId);\n      if (page) hits.push({ type: 'note', note, page: toPage(page) });\n    }\n    return hits;\n  }\n\n  async listPageActivity(input: {\n    read: KnowledgeReadScope;\n    scopeId?: string;\n    pageId?: string;\n    cursor?: string;\n    limit?: number;\n  }): Promise<{ events: KnowledgePageActivityEvent[]; nextCursor?: string }> {\n    const core = await loadPagesCore();\n    const limit = limitOf(input.limit, core.MAX_KNOWLEDGE_PAGE_LIST_LIMIT);\n    const cursor = decodeCursor(input.cursor, 1);\n    const readable = pageReadable('p', input.read);\n    const noteVisible = noteReadable('n', input.read);\n    const args: InValue[] = [...readable.args];\n    let filters = '';\n    if (input.scopeId !== undefined) {\n      filters += ` AND p.scopeId = ?`;\n      args.push(input.scopeId);\n    }\n    if (input.pageId !== undefined) {\n      filters += ` AND e.pageId = ?`;\n      args.push(input.pageId);\n    }\n    if (cursor) {\n      filters += ` AND e.id < ?`;\n      args.push(cursor[0]!);\n    }\n    args.push(...noteVisible.args, limit + 1);\n    const rows = await this.#query(\n      this.#read,\n      `SELECT e.* FROM \"${T.activity}\" e JOIN \"${T.pages}\" p ON p.id = e.pageId WHERE ${readable.sql}${filters} AND (e.noteId IS NULL OR EXISTS (SELECT 1 FROM \"${T.notes}\" n WHERE n.id = e.noteId AND ${noteVisible.sql})) ORDER BY e.id DESC LIMIT ?`,\n      args,\n    );\n    const page = rows.slice(0, limit);\n    return {\n      events: page.map(row => ({\n        id: String(row.id),\n        action: String(row.action) as KnowledgePageActivityAction,\n        scopeId: String(row.scopeId),\n        pageId: String(row.pageId),\n        ...(row.noteId ? { noteId: String(row.noteId) } : {}),\n        provenance: provenance(row.provenance),\n        createdAt: new Date(String(row.createdAt)),\n      })),\n      ...(rows.length > limit ? { nextCursor: encodeCursor([String(page[page.length - 1]!.id)]) } : {}),\n    };\n  }\n\n  /** Rewrites the audience index rows of one pin to match `audience`. */\n  async #indexAudience(tx: PageExecutor, pinId: string, audience: string[]): Promise<void> {\n    await tx.execute({ sql: `DELETE FROM \"${T.pinAudiences}\" WHERE pinId = ?`, args: [pinId] });\n    for (const entry of audience) {\n      await tx.execute({\n        sql: `INSERT OR IGNORE INTO \"${T.pinAudiences}\" (pinId, audience) VALUES (?, ?)`,\n        args: [pinId, entry],\n      });\n    }\n  }\n\n  // Pins\n\n  addPinAudience(input: Parameters<KnowledgePageStore['addPinAudience']>[0]): Promise<KnowledgePin> {\n    const kind = input.kind ?? 'page';\n    const depth = kind === 'list' ? (input.depth ?? 1) : null;\n    return this.#transaction(async tx => {\n      const page = await this.#livePage(tx, input.pageId);\n      const now = new Date().toISOString();\n      const existing = (\n        await this.#query(tx, `SELECT * FROM \"${T.pins}\" WHERE pageId = ? AND kind = ?`, [input.pageId, kind])\n      )[0];\n      if (!existing) {\n        const id = createKnowledgeUlid();\n        await tx.execute({\n          sql: `INSERT INTO \"${T.pins}\" (id, pageId, kind, depth, audience, createdBy, createdAt, updatedAt) VALUES (?, ?, ?, ?, ?, ?, ?, ?)`,\n          args: [\n            id,\n            input.pageId,\n            kind,\n            depth,\n            JSON.stringify([...new Set(input.audience)]),\n            input.createdBy,\n            now,\n            now,\n          ],\n        });\n        await this.#indexAudience(tx, id, [...new Set(input.audience)]);\n        await this.#logActivity(\n          tx,\n          'pin-added',\n          { scopeId: String(page.scopeId), pageId: input.pageId, provenance: { author: input.createdBy } },\n          now,\n        );\n        return toPin((await this.#query(tx, `SELECT * FROM \"${T.pins}\" WHERE id = ?`, [id]))[0]!);\n      }\n      const current = JSON.parse(String(existing.audience)) as string[];\n      const merged = [...new Set([...current, ...input.audience])];\n      const depthChanged = (existing.depth === null ? null : Number(existing.depth)) !== depth;\n      if (merged.length !== current.length || depthChanged) {\n        await tx.execute({\n          sql: `UPDATE \"${T.pins}\" SET audience = ?, depth = ?, updatedAt = ? WHERE id = ?`,\n          args: [JSON.stringify(merged), depth, now, String(existing.id)],\n        });\n        await this.#indexAudience(tx, String(existing.id), merged);\n        await this.#logActivity(\n          tx,\n          'pin-added',\n          { scopeId: String(page.scopeId), pageId: input.pageId, provenance: { author: input.createdBy } },\n          now,\n        );\n      }\n      return toPin((await this.#query(tx, `SELECT * FROM \"${T.pins}\" WHERE id = ?`, [String(existing.id)]))[0]!);\n    });\n  }\n\n  removePinAudience(input: Parameters<KnowledgePageStore['removePinAudience']>[0]): Promise<KnowledgePin | null> {\n    return this.#transaction(async tx => {\n      const existing = (\n        await this.#query(tx, `SELECT * FROM \"${T.pins}\" WHERE pageId = ? AND kind = ?`, [\n          input.pageId,\n          input.kind ?? 'page',\n        ])\n      )[0];\n      if (!existing) return null;\n      const current = JSON.parse(String(existing.audience)) as string[];\n      const remove = new Set(input.audience);\n      const remaining = current.filter(entry => !remove.has(entry));\n      if (remaining.length === current.length) return toPin(existing);\n      const page = await this.#pageRow(tx, input.pageId);\n      const now = new Date().toISOString();\n      if (page) {\n        await this.#logActivity(\n          tx,\n          'pin-removed',\n          { scopeId: String(page.scopeId), pageId: input.pageId, provenance: { author: input.removedBy } },\n          now,\n        );\n      }\n      if (remaining.length === 0) {\n        await this.#indexAudience(tx, String(existing.id), []);\n        await tx.execute({ sql: `DELETE FROM \"${T.pins}\" WHERE id = ?`, args: [String(existing.id)] });\n        return null;\n      }\n      await tx.execute({\n        sql: `UPDATE \"${T.pins}\" SET audience = ?, updatedAt = ? WHERE id = ?`,\n        args: [JSON.stringify(remaining), now, String(existing.id)],\n      });\n      await this.#indexAudience(tx, String(existing.id), remaining);\n      return toPin((await this.#query(tx, `SELECT * FROM \"${T.pins}\" WHERE id = ?`, [String(existing.id)]))[0]!);\n    });\n  }\n\n  async listPins(input: {\n    audience: string[] | 'all';\n    read: KnowledgeReadScope;\n    kind?: KnowledgePinKind;\n    pageIds?: string[];\n    excludePageIds?: string[];\n    withBody?: boolean;\n    count?: boolean;\n    cursor?: string;\n    limit?: number;\n  }): Promise<{ pins: KnowledgeListedPin[]; nextCursor?: string; total?: number }> {\n    const core = await loadPagesCore();\n    const limit = limitOf(input.limit, core.MAX_KNOWLEDGE_PAGE_LIST_LIMIT);\n    const cursor = decodeCursor(input.cursor, 2);\n    const readable = pageReadable('p', input.read);\n    const args: InValue[] = [...readable.args];\n    let filters = '';\n    if (input.audience !== 'all') {\n      filters += ` AND pin.id IN (SELECT pa.pinId FROM json_each(?) a JOIN \"${T.pinAudiences}\" pa ON pa.audience = a.value)`;\n      args.push(jsonList(input.audience));\n    }\n    if (input.kind) {\n      filters += ` AND pin.kind = ?`;\n      args.push(input.kind);\n    }\n    if (input.pageIds) {\n      filters += ` AND pin.pageId IN (SELECT value FROM json_each(?))`;\n      args.push(jsonList(input.pageIds));\n    }\n    if (input.excludePageIds?.length) {\n      filters += ` AND (pin.kind <> 'page' OR pin.pageId NOT IN (SELECT value FROM json_each(?)))`;\n      args.push(jsonList(input.excludePageIds));\n    }\n    if (input.withBody) {\n      filters += ` AND (pin.kind <> 'page' OR (p.body IS NOT NULL AND trim(p.body, char(32, 9, 10, 11, 12, 13)) <> ''))`;\n    }\n    const from = `FROM \"${T.pins}\" pin JOIN \"${T.pages}\" p ON p.id = pin.pageId WHERE p.deletedAt IS NULL AND ${readable.sql}${filters}`;\n    let total: number | undefined;\n    if (input.count) {\n      total = Number((await this.#query(this.#read, `SELECT COUNT(*) AS n ${from}`, args))[0]!.n);\n    }\n    const pageArgs = [...args];\n    let cursorFilter = '';\n    if (cursor) {\n      cursorFilter = ` AND (pin.createdAt < ? OR (pin.createdAt = ? AND pin.id < ?))`;\n      pageArgs.push(cursor[0]!, cursor[0]!, cursor[1]!);\n    }\n    pageArgs.push(limit + 1);\n    const rows = await this.#query(\n      this.#read,\n      `SELECT pin.*, p.name AS pageName ${from}${cursorFilter} ORDER BY pin.createdAt DESC, pin.id DESC LIMIT ?`,\n      pageArgs,\n    );\n    const page = rows.slice(0, limit);\n    return {\n      pins: page.map(toListedPin),\n      ...(rows.length > limit\n        ? { nextCursor: encodeCursor([String(page[page.length - 1]!.createdAt), String(page[page.length - 1]!.id)]) }\n        : {}),\n      ...(total === undefined ? {} : { total }),\n    };\n  }\n}\n", "import { ErrorCategory, ErrorDomain, MastraError } from '@mastra/core/error';\nimport {\n  MCPClientsStorage,\n  createStorageErrorId,\n  normalizePerPage,\n  calculatePagination,\n  TABLE_MCP_CLIENTS,\n  TABLE_MCP_CLIENT_VERSIONS,\n  MCP_CLIENTS_SCHEMA,\n  MCP_CLIENT_VERSIONS_SCHEMA,\n} from '@mastra/core/storage';\nimport type {\n  StorageMCPClientType,\n  StorageCreateMCPClientInput,\n  StorageUpdateMCPClientInput,\n  StorageListMCPClientsInput,\n  StorageListMCPClientsOutput,\n} from '@mastra/core/storage';\nimport type {\n  MCPClientVersion,\n  CreateMCPClientVersionInput,\n  ListMCPClientVersionsInput,\n  ListMCPClientVersionsOutput,\n} from '@mastra/core/storage/domains/mcp-clients';\nimport { LibSQLDB, resolveClient } from '../../db';\nimport type { LibSQLDomainConfig } from '../../db';\nimport type { SqliteClient as Client, SqliteInValue as InValue } from '../../db/client';\nimport { buildSelectColumns } from '../../db/utils';\n\nexport class MCPClientsLibSQL extends MCPClientsStorage {\n  #db: LibSQLDB;\n  #client: Client;\n\n  constructor(config: LibSQLDomainConfig) {\n    su