{
  "name": "template-personal-assistant",
  "version": "1.0.0",
  "description": "A foundation for a configurable personal assistant powered by Mastra and Mastra Connect.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": "^22.19.0 || >=24.11.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/run.mjs dev",
    "build": "node scripts/run.mjs build",
    "start": "node scripts/run.mjs start",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --import tsx --test tests/config.test.ts",
    "test:integration": "node --import tsx --test tests/assistant.test.ts tests/connections.test.ts tests/progress.test.ts tests/schedules.test.ts",
    "test:runtime": "node --import tsx --test tests/runtime.test.ts"
  },
  "dependencies": {
    "@mastra/connect": "^1.3.1",
    "@mastra/core": "^1.82.0",
    "@mastra/libsql": "^1.29.0",
    "@mastra/memory": "^1.41.0",
    "@mastra/observability": "^1.23.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "mastra": "^1.38.0",
    "oxfmt": "0.59.0",
    "@types/node": "^24.10.9",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "@mastra/hono": "^1.7.24",
    "hono": "^4.10.6",
    "@hono/node-server": "^1.19.9"
  }
}
