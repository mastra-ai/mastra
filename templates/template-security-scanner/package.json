{
  "name": "template-security-scanner",
  "version": "0.1.0",
  "description": "Authorized website and API discovery with isolated local identities and bounded evidence.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11"
  },
  "scripts": {
    "setup": "node --env-file-if-exists=.env --import tsx scripts/setup.ts",
    "doctor": "node --env-file-if-exists=.env --import tsx scripts/doctor.ts",
    "dev": "node --env-file-if-exists=.env --import tsx scripts/serve.ts",
    "format": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "build": "tsc --outDir dist",
    "test:unit": "vitest run tests/settings.test.ts tests/control-plane.test.ts tests/discovery.test.ts",
    "pretest:integration": "npm run build",
    "test:integration": "vitest run tests/runtime.integration.test.ts",
    "test:control-plane": "vitest run tests/control-plane.integration.test.ts",
    "test:discovery": "node --import tsx scripts/test-discovery.ts discovery",
    "test:gateway": "node --import tsx scripts/test-discovery.ts gateway",
    "test:intelligence": "vitest run tests/intelligence.integration.test.ts --reporter=verbose",
    "check:gateway": "node --import tsx scripts/check-gateway.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.11",
    "@libsql/client": "^0.18.0",
    "@mastra/core": "latest",
    "@mastra/docker": "latest",
    "@mastra/hono": "latest",
    "@mastra/libsql": "latest",
    "dockerode": "^4.0.9",
    "hono": "^4.12.0",
    "tar-stream": "^3.2.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/dockerode": "^3.3.47",
    "@types/node": "^24.0.0",
    "@types/tar-stream": "^3.1.5",
    "mastra": "latest",
    "oxfmt": "^0.56.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  }
}
