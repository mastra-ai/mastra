# Setup, doctor and dev load this file. Exported shell variables take precedence.
DISCOVERY_DRIVER=katana
SANDBOX_DRIVER=docker
QUEUE_DRIVER=libsql
STORAGE_DRIVER=libsql
DATABASE_URL=file:./data/security-scanner.db
DOCKER_DISCOVERY_IMAGE=security-scanner/katana:1.8.0
DOCKER_PLATFORM=linux/arm64
DOCKER_SOCKET=/var/run/docker.sock
DOCKER_RETAIN_SHARED_BASE_IMAGE=false
DOCKER_REMOVE_SCAN_IMAGES=true
# Discovery remains opt-in after setup and requires authorized, revision-bound targets.
SCANNER_DISCOVERY_ENABLED=false
# REST assessments, investigation planning and recurring reassessment can make paid Morph requests.
SCANNER_INVESTIGATION_ENABLED=false
# Optional periodic advisory workflow. Enable only with explicit cadence/timezone.
SCANNER_ADVISORY_SYNC_ENABLED=false
# SCANNER_ADVISORY_SYNC_CRON=0 6 * * *
# SCANNER_ADVISORY_SYNC_TIMEZONE=America/Sao_Paulo
SANDBOX_MEMORY_MIB=1024
SANDBOX_PIDS=256
COMMAND_TIMEOUT_MS=20000
OUTPUT_LIMIT_BYTES=8192
PORT=4111
# Explicit compatible model configuration. Setup and doctor do not invoke models.
EXPLORER_MODEL=morph-dsv41flash-abliterated
JUDGE_MODEL=morph/morph-glm53-744b
# Required only when SCANNER_INVESTIGATION_ENABLED=true. Never returned by doctor or the API.
MORPH_API_KEY=
# Optional protected local API. Generate independent random values as described in docs/configuration.md.
# Without a bootstrap secret, only sanitized runtime diagnostics are exposed.
# CONTROL_BOOTSTRAP_SECRET=<random base64url secret with at least 32 characters>
# SCANNER_ENCRYPTION_KEY=<64 lowercase hex characters>
CONTROL_SESSION_TTL_SECONDS=1800
