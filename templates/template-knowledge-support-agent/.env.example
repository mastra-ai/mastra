OPENAI_API_KEY=

# Use local for Studio. Choose turso, neon, or postgres for a Mastra Platform deploy.
DATABASE_PROVIDER=local

# Mastra Platform fills these fields for the attached database.
# Turso
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Neon or Postgres (VPC)
DATABASE_URL=

# Mastra Platform organization that owns this deployment.
MASTRA_ORGANIZATION_ID=
# Let the template use the Mastra sign-in provider with its own scoped authorization.
MASTRA_PLATFORM_STUDIO_AUTH=disabled

# Optional external OAuth on Mastra Platform. Set all four for external OAuth or self-hosting.
# SUPPORT_OAUTH_INTROSPECTION_URL=
# SUPPORT_OAUTH_INTROSPECTION_TOKEN=
# SUPPORT_OAUTH_ISSUER=
# SUPPORT_OAUTH_AUDIENCE=knowledge-support

# Set to true for the first deploy to a fresh database after running npm run build.
SUPPORT_SEED_ON_STARTUP=false

# Optional storage and network overrides
# SUPPORT_DATABASE_URL=file:./.local/support.db
# SUPPORT_WRITER_LOCK_FILE=/absolute/path/to/support.writer.sqlite
# SUPPORT_HOST=0.0.0.0
