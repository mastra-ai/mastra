OPENAI_API_KEY=

# local | turso | neon | postgres
DATABASE_PROVIDER=local

# Managed credentials are injected by Mastra Platform.
# Turso
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=
# Neon or Postgres (VPC)
# DATABASE_URL=
# Redis (VPC) does not support Mastra Knowledge.
# REDIS_URL=

# Optional local database file or Turso writer lock path
# SUPPORT_DATABASE_URL=file:./.local/support.db
# SUPPORT_WRITER_LOCK_FILE=/absolute/path/to/support.writer.sqlite

# Hosted authentication and optional bind address
# SUPPORT_OAUTH_INTROSPECTION_URL=
# SUPPORT_OAUTH_INTROSPECTION_TOKEN=
# SUPPORT_OAUTH_ISSUER=
# SUPPORT_OAUTH_AUDIENCE=
# SUPPORT_HOST=

# Seed the selected example on Mastra Platform startup after npm run build
# SUPPORT_SEED_ON_STARTUP=true
