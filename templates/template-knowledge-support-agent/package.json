{
  "name": "template-knowledge-support-agent",
  "version": "1.0.0",
  "description": "A local support agent template powered by Mastra Knowledge.",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.11.0"
  },
  "scripts": {
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "dev": "node scripts/dev.ts",
    "knowledge:seed": "node scripts/seed-knowledge.ts",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test tests/unit/*.test.ts",
    "test:integration": "node --test --test-concurrency=1 tests/integration/*.test.ts"
  },
  "dependencies": {
    "@mastra/core": "latest",
    "@mastra/libsql": "latest",
    "@mastra/memory": "latest",
    "@mastra/observability": "latest",
    "@mastra/pg": "latest",
    "@mastra/server": "latest",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "mastra": "latest",
    "oxfmt": "0.59.0",
    "typescript": "^5.9.3"
  }
}
