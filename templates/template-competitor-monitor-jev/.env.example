# Required for the Studio chat and optional workflow summaries.
OPENAI_API_KEY=replace-with-openai-key

# Direct TypeSafe access to Jev is the default.
TYPESAFE_AI_API_KEY=replace-with-typesafe-key
# JEV_MODEL=jev-latest

# Alternative: use Vercel AI Gateway instead of a TypeSafe key.
# JEV_ACCESS_MODE=vercel-gateway
# AI_GATEWAY_API_KEY=replace-with-gateway-key
# Gateway uses https://ai-gateway.vercel.sh/typesafe/v1 and typesafe-ai/jev.

# Local mode keeps the Mastra server on loopback. Production requires a token.
EXECUTION_MODE=local
# MASTRA_API_TOKEN=replace-before-production

# Relative database paths resolve from the project root.
# MASTRA_DATABASE_URL=file:./.data/mastra.db
# MONITOR_DATABASE_URL=file:./.data/competitor-monitor.db
# Up to 3 pages per monitor by default; raise this up to 20 if needed.
# MAX_SOURCES=3
# SOURCE_CONCURRENCY=3
# CANDIDATES_PER_SOURCE=20

# Disabled by default. Set true after filling scheduled-monitors.json with real URLs.
ENABLE_MONITOR_SCHEDULER=false
