# Required for GPT-6 Luna Responses search, extraction and support verification.
OPENAI_API_KEY=
# local binds to 127.0.0.1. Set production before exposing the server.
LEAD_QUALIFICATION_MODE=local
# Optional loopback/production port; default 4111.
# LEAD_QUALIFICATION_PORT=4111
# Production requires a random token of at least 32 characters.
LEAD_QUALIFICATION_TOKEN=
MASTRA_TELEMETRY_DISABLED=1

# Production defaults to Attio input/output; local defaults ignore unused Attio configuration. Generate attio.mapping.json with scripts/attio-setup.ts; see docs/attio.md.
# Selecting Attio input needs both secrets; JSON input with Attio output needs only the API token.
# ATTIO_API_TOKEN=
# ATTIO_WEBHOOK_SECRET=
