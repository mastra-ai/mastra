# Required for the default OpenAI research provider.
OPENAI_API_KEY=

# One input and one output, selected independently. Both default to local.
# local input accepts JSON; local output stores text/Markdown reports.
# To connect Attio, select attio for either or both directions.
# LEAD_INPUT_PROVIDER=local
# LEAD_OUTPUT_PROVIDER=local

# Local mode binds to loopback. Production requires a token of 32+ characters.
LEAD_QUALIFICATION_MODE=local
LEAD_QUALIFICATION_TOKEN=
# LEAD_QUALIFICATION_PORT=4111
MASTRA_TELEMETRY_DISABLED=1

# Attio selections use attio.mapping.json generated by scripts/attio-setup.ts.
# Output requires the API token; input also requires the webhook secret.
# ATTIO_API_TOKEN=
# ATTIO_WEBHOOK_SECRET=
