{
  "name": "template-lead-qualification",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "postinstall": "node scripts/setup.mjs",
    "dev": "mastra dev",
    "build": "mastra build",
    "start": "mastra start",
    "test": "vitest run",
    "lint": "oxlint --type-aware .",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "eval": "tsx scripts/evaluate.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.17.0",
    "@mastra/core": "latest",
    "@mastra/duckdb": "latest",
    "@mastra/libsql": "latest",
    "@mastra/observability": "latest",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@mastra/server": "latest",
    "@types/node": "^24.0.0",
    "mastra": "latest",
    "oxfmt": "latest",
    "oxlint": "latest",
    "oxlint-tsgolint": "latest",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0",
    "@mastra/hono": "latest",
    "hono": "^4.13.0",
    "@hono/node-server": "^2.0.0",
    "@faker-js/faker": "^10.6.0"
  },
  "description": "Research companies from approved sources and explain deterministic ICP assessments with durable intake and bounded research.",
