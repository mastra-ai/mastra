    "mastra": "latest",
    "oxfmt": "latest",
    "oxlint": "latest",
    "oxlint-tsgolint": "latest",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0",
    "@mastra/hono": "latest",
    "hono": "^4.13.0",
    "@hono/node-server": "^2.0.0"
