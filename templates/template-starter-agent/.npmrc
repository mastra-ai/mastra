; This template tracks @mastra alpha releases via the "alpha" dist-tag.
; Already-published packages declare peer ranges on @mastra/core whose floors
; point at older version tuples, and npm's strict semver rules reject a
; prerelease core (e.g. 1.75.0-alpha.x) against those ranges. Relax peer
; resolution until the template moves back to stable ("latest") versions.
legacy-peer-deps=true
