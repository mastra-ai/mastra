# Gateway — single key proxies to OpenAI, Anthropic, Google, etc.
# https://mastra.ai/docs/models/gateways/mastra
MASTRA_GATEWAY_API_KEY=

# Postgres — primary storage (threads, messages, memory, workflow snapshots).
# Required.
DATABASE_URL=postgres://user:password@localhost:5432/mastra

# Mastra platform — powers @mastra/connect tools() and channels().
# Create a Mastra platform project, attach integrations to it
# (Linear, Notion, Slack, Telegram, Discord, …), then generate an access token.
MASTRA_PLATFORM_ACCESS_TOKEN=
MASTRA_PROJECT_ID=

# Platform workspace — when set, the agent workspace uses PlatformSandbox and
# PlatformFilesystem instead of the local sandbox/filesystem.
# MASTRA_ENVIRONMENT_ID=
# MASTRA_PLATFORM_BUCKET_NAME=

# Optional: organization id (sent as x-organization-id when set)
# MASTRA_ORG_ID=

# Optional: platform region ('us' | 'eu'); defaults to the global endpoint
# MASTRA_PLATFORM_REGION=us
