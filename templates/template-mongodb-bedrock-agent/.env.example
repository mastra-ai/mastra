# --- MongoDB Atlas (RAG vector store + agent memory/storage) ---
# Atlas connection string. Free M0 tier supports Atlas Vector Search.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net
MONGODB_DATABASE=mastra_docs
# Deployment reads MONGODB_SECRET_ARN from agentcore.json; see README for Secrets Manager setup.

# --- AWS Bedrock (LLM + embeddings) ---
# Region must match your Bedrock model access AND the model id's region prefix.
AWS_REGION=us-east-1
# If not using an SSO profile / instance role, uncomment and set static creds:
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_PROFILE=default

# Bedrock model ids (must be enabled in your account + region).
# List options: aws bedrock list-inference-profiles / list-foundation-models
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
EMBED_DIMENSION=1024

# --- Ingestion ---
# How many Mastra doc pages to ingest (from mastra.ai/llms.txt).
DOCS_LIMIT=60
