{
  "name": "@mastra/nestjs",
  "version": "0.2.39",
  "description": "Mastra NestJS adapter for the server",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown --silent --config tsdown.config.ts",
    "build:watch": "pnpm build --watch",
    "test": "vitest run",
    "lint": "oxlint --type-aware .",
    "lint:fix": "oxlint --type-aware --fix ."
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@fastify/busboy": "^3.2.4",
    "@mastra/server": "workspace:*",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@ai-sdk/openai": "^2.0.136",
    "@internal/lint": "workspace:*",
    "@internal/storage-test-utils": "workspace:*",
    "@internal/types-builder": "workspace:*",
    "@mastra/core": "workspace:*",
    "@mastra/evals": "workspace:*",
    "@mastra/libsql": "workspace:*",
    "@mastra/memory": "workspace:*",
    "@mastra/observability": "workspace:*",
    "@mastra/server-adapters-test-suite": "workspace:*",
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/testing": "^12.2.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "22.19.15",
    "@types/supertest": "^6.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "supertest": "^7.3.1",
    "tsdown": "0.23.1",
    "typescript": "catalog:",
    "vitest": "^4.1.12",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "@mastra/core": ">=1.80.0-0 <2.0.0-0",
    "@nestjs/common": "^10.0.0 || ^11.0.0 || ^12.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0 || ^12.0.0",
    "express": "^4.0.0 || ^5.0.0",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "files": [
    "dist"
  ],
  "homepage": "https://mastra.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mastra-ai/mastra.git",
    "directory": "server-adapters/nestjs"
  },
  "bugs": {
    "url": "https://github.com/mastra-ai/mastra/issues"
  }
}
