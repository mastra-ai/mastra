{
  "name": "@mastra/express",
  "version": "1.5.24-alpha.4",
  "description": "Mastra Express adapter for the server",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown --silent --config tsdown.config.ts",
    "build:watch": "pnpm build --watch",
    "test": "vitest run",
    "lint": "oxlint --type-aware .",
    "lint:fix": "oxlint --type-aware --fix ."
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@fastify/busboy": "^3.2.4",
    "@mastra/server": "workspace:*"
  },
  "devDependencies": {
    "@ai-sdk/openai": "^2.0.136",
    "@internal/lint": "workspace:*",
    "@internal/storage-test-utils": "workspace:*",
    "@internal/types-builder": "workspace:*",
    "@mastra/ai-sdk": "workspace:*",
    "@mastra/core": "workspace:*",
    "@mastra/evals": "workspace:*",
    "@mastra/libsql": "workspace:*",
    "@mastra/memory": "workspace:*",
    "@mastra/observability": "workspace:*",
    "@mastra/server-adapters-test-suite": "workspace:*",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "22.19.15",
    "@types/swagger-ui-express": "^4.1.8",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "swagger-ui-express": "^5.0.1",
    "tsdown": "0.23.1",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@mastra/core": ">=1.58.0-0 <2.0.0-0",
    "@types/express": "^5.0.5",
    "express": "^5.1.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "files": [
    "dist"
  ],
  "homepage": "https://mastra.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mastra-ai/mastra.git",
    "directory": "server-adapters/express"
  },
  "bugs": {
    "url": "https://github.com/mastra-ai/mastra/issues"
  }
}
