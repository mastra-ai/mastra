{
  "name": "@mastra/elysia",
  "version": "0.1.0-alpha.1",
  "description": "Mastra Elysia adapter for the server",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown --silent --config tsdown.config.ts",
    "build:watch": "pnpm build --watch",
    "test": "vitest run",
    "lint": "oxlint . && eslint .",
    "lint:fix": "oxlint --fix . && eslint --fix ."
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@mastra/server": "workspace:*",
    "fetch-to-node": "^2.1.0"
  },
  "devDependencies": {
    "@ai-sdk/openai": "^2.0.62",
    "@elysiajs/cors": "^1.4.1",
    "@elysiajs/openapi": "^1.4.14",
    "@internal/lint": "workspace:*",
    "@internal/server-adapter-test-utils": "workspace:*",
    "@internal/storage-test-utils": "workspace:*",
    "@internal/types-builder": "workspace:*",
    "@mastra/core": "workspace:*",
    "@mastra/libsql": "workspace:*",
    "@mastra/memory": "workspace:*",
    "@mastra/observability": "workspace:*",
    "@sinclair/typebox": "^0.34.48",
    "@types/node": "22.20.1",
    "elysia": "^1.4.25",
    "eslint": "^10.7.0",
    "exact-mirror": "^0.2.7",
    "openapi-types": "^12.1.3",
    "tsdown": "0.22.9",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@mastra/core": ">=1.50.0-0 <2.0.0-0",
    "elysia": "^1.4.25"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "homepage": "https://mastra.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mastra-ai/mastra.git",
    "directory": "server-adapters/elysia"
  },
  "bugs": {
    "url": "https://github.com/mastra-ai/mastra/issues"
  }
}
