{
  "name": "@mastra/elysia",
  "version": "0.1.20-alpha.3",
  "description": "Mastra Elysia adapter for the server",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown --silent --config tsdown.config.ts",
    "build:watch": "pnpm build --watch",
    "test": "vitest run",
    "lint": "oxlint --type-aware .",
    "lint:fix": "oxlint --type-aware --fix ."
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@mastra/server": "workspace:*",
    "fetch-to-node": "^2.1.0"
  },
  "devDependencies": {
    "@ai-sdk/openai": "^2.0.136",
    "@copilotkit/aimock": "^1.46.0",
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/node": "^1.4.5",
    "@elysiajs/openapi": "^1.4.16",
    "@internal/lint": "workspace:*",
    "@internal/storage-test-utils": "workspace:*",
    "@internal/types-builder": "workspace:*",
    "@mastra/core": "workspace:*",
    "@mastra/libsql": "workspace:*",
    "@mastra/memory": "workspace:*",
    "@mastra/observability": "workspace:*",
    "@mastra/server-adapters-test-suite": "workspace:*",
    "@sinclair/typebox": "^0.34.52",
    "@types/node": "22.19.15",
    "elysia": "^1.4.30",
    "exact-mirror": "^0.2.7",
    "openapi-types": "^12.1.3",
    "tsdown": "0.23.1",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@mastra/core": ">=1.58.0-0 <2.0.0-0",
    "elysia": "^1.4.25"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "files": [
    "dist"
  ],
  "homepage": "https://mastra.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mastra-ai/mastra.git",
    "directory": "server-adapters/elysia"
  },
  "bugs": {
    "url": "https://github.com/mastra-ai/mastra/issues"
  }
}
