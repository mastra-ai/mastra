{
  "name": "@mastra/adonisjs",
  "version": "0.0.0",
  "description": "Mastra AdonisJS adapter for the server",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown --silent --config tsdown.config.ts",
    "build:watch": "pnpm build --watch",
    "test": "vitest run",
    "lint": "oxlint --type-aware .",
    "lint:fix": "oxlint --type-aware --fix ."
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@fastify/busboy": "^3.2.2",
    "@mastra/server": "workspace:*"
  },
  "devDependencies": {
    "@adonisjs/core": "^6.21.0",
    "@ai-sdk/openai": "^2.0.135",
    "@copilotkit/aimock": "^1.29.0",
    "@internal/lint": "workspace:*",
    "@internal/storage-test-utils": "workspace:*",
    "@internal/types-builder": "workspace:*",
    "@mastra/core": "workspace:*",
    "@mastra/evals": "workspace:*",
    "@mastra/libsql": "workspace:*",
    "@mastra/mcp": "workspace:*",
    "@mastra/memory": "workspace:*",
    "@mastra/observability": "workspace:*",
    "@mastra/server-adapters-test-suite": "workspace:*",
    "@types/node": "22.20.5",
    "tsdown": "0.23.1",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@adonisjs/core": "^6.12.0",
    "@mastra/core": ">=1.58.0-0 <2.0.0-0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "files": [
    "dist"
  ],
  "homepage": "https://mastra.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mastra-ai/mastra.git",
    "directory": "server-adapters/adonisjs"
  },
  "bugs": {
    "url": "https://github.com/mastra-ai/mastra/issues"
  }
}
