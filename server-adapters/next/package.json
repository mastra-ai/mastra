{
  "name": "@mastra/next",
  "version": "0.2.38-alpha.6",
  "description": "Mastra Next.js server adapter — drop your Mastra instance into a Next.js app",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown --silent --config tsdown.config.ts",
    "build:watch": "pnpm build --watch",
    "test": "vitest run",
    "lint": "oxlint --type-aware .",
    "lint:fix": "oxlint --type-aware --fix ."
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@mastra/hono": "workspace:*",
    "@mastra/server": "workspace:*"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.3",
    "@internal/lint": "workspace:*",
    "@internal/types-builder": "workspace:*",
    "@mastra/core": "workspace:*",
    "@mastra/server-adapters-test-suite": "workspace:*",
    "@types/node": "22.19.15",
    "hono": "^4.13.13",
    "tsdown": "0.23.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@mastra/core": ">=1.80.0-0 <2.0.0-0",
    "hono": "^4.13.5"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "files": [
    "dist"
  ],
  "homepage": "https://mastra.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mastra-ai/mastra.git",
    "directory": "server-adapters/next"
  },
  "bugs": {
    "url": "https://github.com/mastra-ai/mastra/issues"
  }
}
