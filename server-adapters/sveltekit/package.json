{
  "name": "@mastra/sveltekit",
  "version": "0.1.0",
  "description": "Mastra SvelteKit server adapter — drop your Mastra instance into a SvelteKit app",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown --silent --config tsdown.config.ts",
    "build:watch": "pnpm build --watch",
    "test": "vitest run",
    "lint": "oxlint . && eslint .",
    "lint:fix": "oxlint --fix . && eslint --fix ."
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@mastra/server": "workspace:*",
    "@mastra/hono": "workspace:*"
  },
  "devDependencies": {
    "@internal/lint": "workspace:*",
    "@internal/types-builder": "workspace:*",
    "@mastra/core": "workspace:*",
    "@types/node": "22.20.1",
    "eslint": "^10.7.0",
    "hono": "^4.13.7",
    "tsdown": "0.22.9",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@mastra/core": ">=1.58.0-0 <2.0.0-0",
    "hono": "^4.13.5"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "files": [
    "dist"
  ],
  "homepage": "https://mastra.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mastra-ai/mastra.git",
    "directory": "server-adapters/sveltekit"
  },
  "bugs": {
    "url": "https://github.com/mastra-ai/mastra/issues"
  }
}
