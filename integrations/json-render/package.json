{
  "name": "@mastra/json-render",
  "version": "0.0.0",
  "description": "Let Mastra agents compose json-render interfaces that stream to the client and stay in memory",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build:lib": "tsdown --silent --config tsdown.config.ts",
    "build:watch": "pnpm build:lib --watch",
    "lint": "oxlint --type-aware .",
    "lint:fix": "oxlint --type-aware --fix .",
    "test": "vitest run"
  },
  "keywords": [
    "mastra",
    "json-render",
    "generative-ui",
    "ai-agent"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mastra-ai/mastra.git",
    "directory": "integrations/json-render"
  },
  "bugs": {
    "url": "https://github.com/mastra-ai/mastra/issues"
  },
  "homepage": "https://mastra.ai",
  "engines": {
    "node": ">=22.13.0"
  },
  "peerDependencies": {
    "@json-render/core": "^0.22.0",
    "@mastra/core": ">=1.83.0-0 <2.0.0-0",
    "zod": ">=3.25.0 || >=4.0.0"
  },
  "devDependencies": {
    "@internal/ai-sdk-v5": "workspace:*",
    "@internal/lint": "workspace:*",
    "@internal/types-builder": "workspace:*",
    "@json-render/core": "0.22.0",
    "@json-render/react": "0.22.0",
    "@mastra/core": "workspace:*",
    "@mastra/memory": "workspace:*",
    "@mastra/react": "workspace:*",
    "@tanstack/react-query": "^5.104.5",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "jsdom": "^30.1.3",
    "msw": "^2.15.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsdown": "0.23.1",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
}
