{
  "name": "mastra-docs",
  "version": "0.0.89",
  "private": true,
  "repository": "https://github.com/mastra-ai/mastra",
  "homepage": "https://mastra.ai",
  "bugs": "https://github.com/mastra-ai/mastra",
  "scripts": {
    "docusaurus": "docusaurus",
    "dev": "docusaurus start",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "validate:frontmatter": "tsx scripts/validate-frontmatter.ts",
    "validate:reference-sidebar": "tsx scripts/validate-reference-sidebar-sort.ts",
    "validate:reference-sidebar:fix": "tsx scripts/validate-reference-sidebar-sort.ts --fix",
    "validate:sidebar-docs": "tsx scripts/validate-sidebar-docs.ts",
    "validate:sidebar-new-tags": "tsx scripts/validate-sidebar-new-tags.ts",
    "validate": "npm-run-all --parallel validate:frontmatter validate:reference-sidebar validate:sidebar-docs validate:sidebar-new-tags",
    "generate-vercel-redirects": "node scripts/generate-vercel-redirects.mjs",
    "format": "pnpm format:oxfmt && pnpm format:mdx",
    "vale:download": "node scripts/vale/download.mjs",
    "vale": "scripts/vale/bin/vale",
    "vale:sync": "scripts/vale/bin/vale sync",
    "lint:vale": "scripts/vale/bin/vale src/content/en/docs src/content/en/integrations src/content/en/reference",
    "lint:vale:ai": "pnpm lint:vale --minAlertLevel=error --output=line",
    "lint:remark": "remark --no-stdout --frail --quiet --ext mdx src/content/en/docs src/content/en/integrations src/content/en/reference",
    "lint:prose": "npm-run-all --parallel lint:vale:ai lint:remark",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:e2e": "pnpm exec playwright test",
    "test:smoke": "pnpm exec playwright test tests/smoke.spec.ts --project=desktop",
    "test:og": "pnpm exec playwright test tests/og-image.spec.ts --project=desktop",
    "test:navigation": "pnpm exec playwright test tests/navigation.spec.ts",
    "format:check": "pnpm format:oxfmt:check && pnpm format:mdx:check",
    "format:oxfmt": "oxfmt .",
    "format:oxfmt:check": "oxfmt --check .",
    "format:mdx": "oxfmt-mdx --write src/content/en/docs src/content/en/integrations src/content/en/reference",
    "format:mdx:check": "oxfmt-mdx --check src/content/en/docs src/content/en/integrations src/content/en/reference"
  },
  "dependencies": {
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/faster": "^3.10.2",
    "@docusaurus/plugin-content-docs": "^3.10.2",
    "@docusaurus/plugin-vercel-analytics": "^3.10.2",
    "@docusaurus/preset-classic": "^3.10.2",
    "@docusaurus/remark-plugin-npm2yarn": "^3.10.2",
    "@docusaurus/theme-common": "^3.10.2",
    "@docusaurus/theme-mermaid": "^3.10.2",
    "@headlessui/react": "^2.2.10",
    "@hookform/resolvers": "^5.9.2",
    "@kapaai/react-sdk": "^0.9.10",
    "@mastra/docusaurus-plugin-algolia": "^1.1.3",
    "@mastra/docusaurus-plugin-kapa": "^1.2.1",
    "@mdx-js/react": "^3.1.1",
    "@mermaid-js/layout-elk": "^0.1.9",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@tanstack/react-virtual": "^3.14.22",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "fs-extra": "^11.4.1",
    "hast-util-select": "^6.0.4",
    "hast-util-to-mdast": "^10.1.2",
    "lucide-react": "^1.61.0",
    "mermaid": "^11.17.2",
    "posthog-docusaurus": "^2.0.5",
    "posthog-js": "^1.438.21",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-hotkeys-hook": "^5.3.3",
    "rehype-parse": "^9.0.1",
    "rehype-remark": "^10.0.1",
    "remark-stringify": "^11.0.0",
    "tinyglobby": "^0.2.17",
    "unified": "^11.0.5",
    "use-stick-to-bottom": "^1.1.6",
    "valibot": "1.4.2"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.10.2",
    "@docusaurus/tsconfig": "^3.10.2",
    "@docusaurus/types": "^3.10.2",
    "@mastra/lint-docs": "^1.1.3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/fs-extra": "^11.0.4",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "22.19.15",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "baseline-browser-mapping": "^2.11.32",
    "jsdom": "^30.1.3",
    "oxfmt": "0.59.0",
    "postcss": "8.5.23",
    "remark-cli": "^12.0.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "unist-util-visit": "^5.2.0",
    "vitest": "4.1.12"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  }
}
