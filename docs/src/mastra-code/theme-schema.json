{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Mastra Code custom theme",
  "description": "Color theme for the Mastra Code TUI. Place in ~/.mastracode/themes/<name>.json and apply with /theme <name>.",
  "type": "object",
  "required": ["appearance"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "name": {
      "type": "string",
      "description": "Display name. Defaults to the file name."
    },
    "appearance": {
      "enum": ["dark", "light"],
      "description": "Selects the surface palette and the built-in theme used as fallback for unset colors."
    },
    "bg": {
      "$ref": "#/definitions/colorValue",
      "description": "Terminal background the theme is designed for. Panel shades and contrast adaptation derive from it; the terminal background is not painted. Omit to adapt to the terminal's own background."
    },
    "vars": {
      "type": "object",
      "description": "Named palette. Values must be hex colors.",
      "additionalProperties": { "$ref": "#/definitions/hex" }
    },
    "colors": {
      "type": "object",
      "description": "Color overrides. Values are a hex color or the name of a var.",
      "additionalProperties": false,
      "properties": {
        "accent": { "$ref": "#/definitions/colorValue" },
        "border": { "$ref": "#/definitions/colorValue" },
        "borderAccent": { "$ref": "#/definitions/colorValue" },
        "borderMuted": { "$ref": "#/definitions/colorValue" },
        "success": { "$ref": "#/definitions/colorValue" },
        "error": { "$ref": "#/definitions/colorValue" },
        "warning": { "$ref": "#/definitions/colorValue" },
        "muted": { "$ref": "#/definitions/colorValue" },
        "dim": { "$ref": "#/definitions/colorValue" },
        "text": { "$ref": "#/definitions/colorValue" },
        "secondary": { "$ref": "#/definitions/colorValue" },
        "thinkingText": { "$ref": "#/definitions/colorValue" },
        "userMessageBg": { "$ref": "#/definitions/colorValue" },
        "userMessageText": { "$ref": "#/definitions/colorValue" },
        "systemReminderBg": { "$ref": "#/definitions/colorValue" },
        "toolPendingBg": { "$ref": "#/definitions/colorValue" },
        "toolSuccessBg": { "$ref": "#/definitions/colorValue" },
        "toolErrorBg": { "$ref": "#/definitions/colorValue" },
        "toolBorderPending": { "$ref": "#/definitions/colorValue" },
        "toolBorderSuccess": { "$ref": "#/definitions/colorValue" },
        "toolBorderError": { "$ref": "#/definitions/colorValue" },
        "toolTitle": { "$ref": "#/definitions/colorValue" },
        "toolArgs": { "$ref": "#/definitions/colorValue" },
        "toolOutput": { "$ref": "#/definitions/colorValue" },
        "textHighlight": { "$ref": "#/definitions/colorValue" },
        "selectedBg": { "$ref": "#/definitions/colorValue" },
        "overlayBg": { "$ref": "#/definitions/colorValue" },
        "errorBg": { "$ref": "#/definitions/colorValue" },
        "path": { "$ref": "#/definitions/colorValue" },
        "number": { "$ref": "#/definitions/colorValue" },
        "function": { "$ref": "#/definitions/colorValue" }
      }
    }
  },
  "definitions": {
    "hex": {
      "type": "string",
      "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
    },
    "colorValue": {
      "type": "string",
      "description": "A hex color (#rgb or #rrggbb) or the name of an entry in vars."
    }
  }
}
