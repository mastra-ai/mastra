{
  "extends": "@docusaurus/tsconfig",
  "compilerOptions": {
    "baseUrl": ".",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["@docusaurus/module-type-aliases", "@docusaurus/theme-classic", "youtube"],
    "paths": {
      "@site/*": ["./*"],
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "@theme/*": ["./src/theme/*", "./node_modules/@mastra/docusaurus-plugin-algolia/dist/theme/*"]
    }
  },
  "include": ["src/**/*", "config/docs"]
}
