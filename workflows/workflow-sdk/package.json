{
  "name": "@mastra/workflow-sdk",
  "version": "0.0.0",
  "description": "Mastra Workflow SDK integration - run Mastra workflows on Vercel's Workflow SDK",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./workflows": {
      "import": {
        "types": "./dist/workflows/index.d.ts",
        "default": "./dist/workflows/index.js"
      }
    },
    "./executor": {
      "import": {
        "types": "./dist/executor.d.ts",
        "default": "./dist/executor.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup --silent --config tsup.config.ts",
    "build:watch": "pnpm build --watch",
    "test": "vitest run --config vitest.config.ts",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "lint": "oxlint . && eslint .",
    "lint:fix": "oxlint --fix . && eslint --fix .",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "mastra",
    "workflow",
    "vercel",
    "durable-execution",
    "workflow-sdk"
  ],
  "author": "Mastra",
  "license": "Apache-2.0",
  "devDependencies": {
    "@internal/lint": "workspace:*",
    "@internal/workflow-test-utils": "workspace:*",
    "@internal/types-builder": "workspace:*",
    "@mastra/core": "workspace:*",
    "@types/node": "22.20.1",
    "@workflow/vitest": "5.0.0-beta.36",
    "eslint": "^10.7.0",
    "tsup": "^8.5.1",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "workflow": "5.0.0-beta.36",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@mastra/core": ">=1.50.0-0 <2.0.0-0",
    "workflow": ">=5.0.0-beta.36 <6.0.0",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "homepage": "https://mastra.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mastra-ai/mastra.git",
    "directory": "workflows/workflow-sdk"
  },
  "bugs": {
    "url": "https://github.com/mastra-ai/mastra/issues"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
