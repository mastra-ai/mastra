    "@xyflow/react": "^12.12.0",
    "ajv": "^8.20.0",
    "date-fns": "catalog:",
    "idb": "^8.0.4",
    "livekit-client": "^2.23.0",
    "lucide-react": "catalog:",
    "nanoid": "^5.1.16",
    "papaparse": "^5.7.0",
    "posthog-js": "^1.438.21",
    "prism-react-renderer": "^2.4.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "^7.91.0",
    "react-markdown": "^9.1.0",
    "react-resizable-panels": "^4.15.0",
    "react-router": "^8.5.0",
    "react-syntax-highlighter": "^15.6.6",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
