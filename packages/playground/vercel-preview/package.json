{
  "name": "studio-preview",
  "type": "module",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "build": "pnpm build:linked-workspace-deps && pnpm mastra:build",
    "build:linked-workspace-deps": "node scripts/build-linked-workspace-deps.mjs",
    "dev": "pnpm build:linked-workspace-deps && pnpm mastra:dev",
    "mastra:build": "node ../../../packages/cli/dist/index.js build",
    "mastra:dev": "node ../../../packages/cli/dist/index.js dev",
    "typecheck": "pnpm build:linked-workspace-deps && tsc --noEmit"
  },
  "dependencies": {
    "@mastra/core": "latest",
    "@mastra/deployer-vercel": "latest",
    "@mastra/editor": "latest",
    "@mastra/memory": "latest",
    "hono": "^4.12.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "mastra": "latest",
    "turbo": "^2.9.12",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "overrides": {
      "@mastra/core": "link:../../../packages/core",
      "@mastra/deployer-vercel": "link:../../../deployers/vercel",
      "@mastra/editor": "link:../../../packages/editor",
      "@mastra/memory": "link:../../../packages/memory",
      "mastra": "link:../../../packages/cli"
    }
  },
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.5.3"
}
