        },
      },
      "text": "",
    },
    "runId": "test-run-id",
    "type": "reasoning",
  },
  {
    "from": "AGENT",
    "payload": {
      "id": "3",
      "providerMetadata": {
        "testProvider": {
          "signature": "1234567890",
        },
      },
      "text": " Once the user has relaxed, I will pry for valuable information.",
    },
    "runId": "test-run-id",
    "type": "reasoning",
  },
  {
    "from": "AGENT",
    "payload": {
      "id": "4",
      "providerMetadata": {
        "testProvider": {
          "signature": "0987654321",
        },
      },
      "text": " I need to think about this problem carefully.",
    },
    "runId": "test-run-id",
    "type": "reasoning",
  },
  {
    "from": "AGENT",
    "payload": {
      "id": "5",
      "providerMetadata": {
        "testProvider": {
          "signature": "0987654321",
        },
      },
      "text": " The best solution requires careful consideration of all factors.",
    },
    "runId": "test-run-id",
    "type": "reasoning",
  },
]
`;

