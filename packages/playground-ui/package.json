    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-virtual": "^3.14.22",
    "@uiw/react-codemirror": "^4.25.12",
    "@xyflow/react": "^12.12.0",
    "cmdk": "^1.1.1",
    "date-fns": "catalog:",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-to-markdown": "^2.2.0",
    "nanoid": "^5.1.16",
    "prettier": "^3.9.5",
    "prism-react-renderer": "^2.4.1",
