{
  "name": "@mastra/playground-ui",
  "type": "module",
  "version": "66.0.0-alpha.6",
  "description": "Mastra Playground components",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "theme.css",
    "components.css",
    "sources.css",
    "theme",
    "oxlint"
  ],
  "exports": {
    "./style.css": "./dist/style.css",
    "./theme.css": "./theme.css",
    "./components.css": "./components.css",
    "./sources.css": "./sources.css",
    "./oxlint": {
      "import": {
        "types": "./oxlint/index.d.ts",
        "default": "./oxlint/index.js"
      },
      "require": {
        "types": "./oxlint/index.d.ts",
        "default": "./oxlint/index.js"
      }
    },
    "./tokens": {
      "import": {
        "types": "./dist/tokens.d.ts",
        "default": "./dist/tokens.es.js"
      },
      "require": {
        "types": "./dist/tokens.d.ts",
        "default": "./dist/tokens.cjs.js"
      }
    },
    "./utils/*": {
      "import": {
        "types": "./dist/utils/*.d.ts",
        "default": "./dist/utils/*.es.js"
      },
      "require": {
        "types": "./dist/utils/*.d.ts",
        "default": "./dist/utils/*.cjs.js"
      }
    },
    "./domains/*": {
      "import": {
        "types": "./dist/domains/*.d.ts",
        "default": "./dist/domains/*.es.js"
      },
      "require": {
        "types": "./dist/domains/*.d.ts",
        "default": "./dist/domains/*.cjs.js"
      }
    },
    "./ee/*": {
      "import": {
        "types": "./dist/ee/*.d.ts",
        "default": "./dist/ee/*.es.js"
      },
      "require": {
        "types": "./dist/ee/*.d.ts",
        "default": "./dist/ee/*.cjs.js"
      }
    },
    "./primitives/*": {
      "import": {
        "types": "./dist/primitives/*.d.ts",
        "default": "./dist/primitives/*.es.js"
      },
      "require": {
        "types": "./dist/primitives/*.d.ts",
        "default": "./dist/primitives/*.cjs.js"
      }
    },
    "./keyboard/*": {
      "import": {
        "types": "./dist/keyboard/*.d.ts",
        "default": "./dist/keyboard/*.es.js"
      },
      "require": {
        "types": "./dist/keyboard/*.d.ts",
        "default": "./dist/keyboard/*.cjs.js"
      }
    },
    "./resize/*": {
      "import": {
        "types": "./dist/resize/*.d.ts",
        "default": "./dist/resize/*.es.js"
      },
      "require": {
        "types": "./dist/resize/*.d.ts",
        "default": "./dist/resize/*.cjs.js"
      }
    },
    "./sort/*": {
      "import": {
        "types": "./dist/sort/*.d.ts",
        "default": "./dist/sort/*.es.js"
      },
      "require": {
        "types": "./dist/sort/*.d.ts",
        "default": "./dist/sort/*.cjs.js"
      }
    },
    "./lib/*": {
      "import": {
        "types": "./dist/lib/*.d.ts",
        "default": "./dist/lib/*.es.js"
      },
      "require": {
        "types": "./dist/lib/*.d.ts",
        "default": "./dist/lib/*.cjs.js"
      }
    },
    "./hooks/*": {
      "import": {
        "types": "./dist/hooks/*.d.ts",
        "default": "./dist/hooks/*.es.js"
      }
    },
    "./icons/*": {
      "import": {
        "types": "./dist/icons/*.d.ts",
        "default": "./dist/icons/*.es.js"
      }
    },
    "./components/*": {
      "import": {
        "types": "./dist/components/*.d.ts",
        "default": "./dist/components/*.es.js"
      }
    },
    "./package.json": "./package.json",
    "./new/settings": {
      "import": {
        "types": "./dist/new/settings.d.ts",
        "default": "./dist/new/settings.es.js"
      }
    },
    "./new/layout/app-shell": {
      "import": {
        "types": "./dist/new/layout/app-shell.d.ts",
        "default": "./dist/new/layout/app-shell.es.js"
      }
    },
    "./layout/tabbed-container": {
      "import": {
        "types": "./dist/layout/tabbed-container.d.ts",
        "default": "./dist/layout/tabbed-container.es.js"
      }
    }
  },
  "scripts": {
    "build": "vite build",
    "dev": "node scripts/prune-dist.mjs && vite build --watch --mode development",
    "test": "vitest",
    "test:mutate": "stryker run --mutate",
    "typecheck": "tsc",
    "lint": "oxlint --type-aware .",
    "lint:fix": "oxlint --type-aware --fix .",
    "build:publish": "pnpm build && yalc push",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "pnpm turbo build --filter @mastra/core --filter @mastra/react && storybook build"
  },
  "keywords": [
    "mastra",
    "playground",
    "components"
  ],
  "author": "Mastra",
  "license": "Apache-2.0",
