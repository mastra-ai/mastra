{
  "name": "@mastra/connect",
  "version": "1.0.0-alpha.2",
  "description": "Use Mastra platform integration connections as agent toolsets",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "NOTICE.md",
    "LICENSE-ELv2.txt"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "add-provider": "tsx scripts/add-provider.ts",
    "build:lib": "tsdown --silent --config tsdown.config.ts",
    "build:watch": "pnpm build:lib --watch",
    "generate-provider": "tsx scripts/generate-provider.ts",
    "generate:provider-docs": "tsx scripts/generate-provider-docs.ts && pnpm format:provider-docs",
    "format:provider-docs": "cd ../../docs && pnpm oxfmt-mdx --write src/content/en/reference/connect/providers.mdx",
    "lint": "oxlint . && eslint .",
    "lint:fix": "oxlint --fix . && eslint --fix .",
    "list-providers": "tsx scripts/list-providers.ts",
    "remove-provider": "tsx scripts/remove-provider.ts",
    "smoke-test": "tsx scripts/smoke-test/index.ts",
    "smoke-test:channels": "tsx scripts/smoke-test/channels/index.ts",
    "sync-templates": "tsx scripts/sync-templates.ts",
    "test": "vitest run && tsc --noEmit"
  },
  "keywords": [
    "mastra",
    "connect",
    "integrations",
    "tools",
    "ai-agent"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mastra-ai/mastra.git",
    "directory": "packages/connect"
  },
  "bugs": {
    "url": "https://github.com/mastra-ai/mastra/issues"
  },
  "homepage": "https://mastra.ai",
  "engines": {
    "node": ">=22.13.0"
  },
  "peerDependencies": {
    "@mastra/core": ">=1.75.0-0 <2.0.0-0",
    "zod": ">=3.0.0 || >=4.0.0"
  },
  "devDependencies": {
    "@internal/lint": "workspace:*",
    "@internal/types-builder": "workspace:*",
    "@mastra/core": "workspace:*",
    "hono": "^4.13.7",
    "prettier": "3.9.5",
    "ts-morph": "^27.0.2",
    "tsdown": "0.22.9",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "dependencies": {
    "@mastra/discord": "workspace:^",
    "@mastra/mcp": "workspace:^",
    "@mastra/slack": "workspace:^",
    "@mastra/teams": "workspace:^",
    "@mastra/telegram": "workspace:^"
  }
}
