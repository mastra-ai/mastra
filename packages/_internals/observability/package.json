{
  "name": "@internal/observability",
  "version": "0.0.0",
  "description": "Internal Mastra observability primitives and utilities",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./context-storage": {
      "import": {
        "types": "./dist/context-storage.d.ts",
        "default": "./dist/context-storage.js"
      },
      "require": {
        "types": "./dist/context-storage.d.ts",
        "default": "./dist/context-storage.cjs"
      }
    },
    "./storage": {
      "import": {
        "types": "./dist/storage/index.d.ts",
        "default": "./dist/storage/index.js"
      },
      "require": {
        "types": "./dist/storage/index.d.ts",
        "default": "./dist/storage/index.cjs"
      }
    },
    "./storage/tracing": {
      "import": {
        "types": "./dist/storage/tracing.d.ts",
        "default": "./dist/storage/tracing.js"
      },
      "require": {
        "types": "./dist/storage/tracing.d.ts",
        "default": "./dist/storage/tracing.cjs"
      }
    },
    "./storage/record-builders": {
      "import": {
        "types": "./dist/storage/record-builders.d.ts",
        "default": "./dist/storage/record-builders.js"
      },
      "require": {
        "types": "./dist/storage/record-builders.d.ts",
        "default": "./dist/storage/record-builders.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown --silent --config tsdown.config.ts",
    "build:watch": "tsdown --watch --silent --config tsdown.config.ts",
    "test": "vitest run",
    "lint": "oxlint . && eslint .",
    "lint:fix": "oxlint --fix . && eslint --fix .",
    "typecheck": "tsc --noEmit -p tsconfig.build.json"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@ai-sdk/provider-v5": "npm:@ai-sdk/provider@2.0.3",
    "@internal/core": "workspace:*"
  },
  "devDependencies": {
    "@internal/lint": "workspace:*",
    "@internal/test-utils": "workspace:*",
    "@internal/types-builder": "workspace:*",
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "eslint": "^10.7.0",
    "tsdown": "0.22.9",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "zod": "^3.25.0 || ^4.0.0"
  },
  "homepage": "https://mastra.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mastra-ai/mastra.git",
    "directory": "packages/_internals/observability"
  },
  "bugs": {
    "url": "https://github.com/mastra-ai/mastra/issues"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
