{
  "name": "@mastra/agent-builder",
  "version": "1.1.30-alpha.0",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "lint": "oxlint . && eslint .",
    "lint:fix": "oxlint --fix . && eslint --fix .",
    "build": "tsdown --silent --config tsdown.config.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@mastra/memory": "workspace:*",
    "@mastra/schema-compat": "workspace:*",
    "ignore": "^7.0.5"
  },
  "devDependencies": {
    "@internal/lint": "workspace:*",
    "@internal/types-builder": "workspace:*",
    "@mastra/core": "workspace:*",
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "eslint": "^10.7.0",
    "tsdown": "0.22.9",
    "typescript": "catalog:ts6",
    "typescript-eslint": "^8.57.0",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@mastra/core": ">=2.0.0-0 <3.0.0-0",
    "typescript": ">=5.7.0",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "keywords": [
    "ai",
    "llm",
    "agent",
    "agents",
    "mastra",
    "builder",
    "typescript"
  ],
  "homepage": "https://mastra.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mastra-ai/mastra.git",
    "directory": "packages/agent-builder"
  },
  "bugs": {
    "url": "https://github.com/mastra-ai/mastra/issues"
  }
}
