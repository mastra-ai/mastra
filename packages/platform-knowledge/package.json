{
  "name": "@mastra/platform-knowledge",
  "version": "0.1.0-alpha.0",
  "type": "module",
  "description": "Mastra Platform hosted Knowledge client",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsdown --silent --config tsdown.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": { "@mastra/core": "workspace:*" },
  "devDependencies": {
    "@internal/ai-sdk-v5": "workspace:*",
    "@internal/types-builder": "workspace:*",
    "@mastra/core": "workspace:*",
    "@mastra/pg": "workspace:*",
    "@types/node": "22.19.15",
    "tsdown": "0.23.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": { "node": ">=22.13.0" }
}
