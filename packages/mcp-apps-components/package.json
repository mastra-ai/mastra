{
  "name": "@mastra/mcp-apps-components",
  "version": "0.1.0-alpha.1",
  "description": "Prebuilt MCP Apps, ready to register as MCP server app resources",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./host": {
      "import": {
        "types": "./dist/host.d.ts",
        "default": "./dist/host.js"
      },
      "require": {
        "types": "./dist/host.d.ts",
        "default": "./dist/host.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "homepage": "https://mastra.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mastra-ai/mastra.git",
    "directory": "packages/mcp-apps-components"
  },
  "bugs": {
    "url": "https://github.com/mastra-ai/mastra/issues"
  },
  "scripts": {
    "build": "tsx scripts/build-apps.ts && tsdown --silent --config tsdown.config.ts",
    "pretest": "pnpm turbo build --filter @mastra/mcp-apps-components",
    "test": "vitest run --project 'unit:packages/mcp-apps-components'",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware .",
    "lint:fix": "oxlint --type-aware --fix ."
  },
  "devDependencies": {
    "@internal/lint": "workspace:*",
    "@internal/types-builder": "workspace:*",
    "@mastra/client-js": "workspace:*",
    "@mastra/core": "workspace:*",
    "@mastra/mcp": "workspace:*",
    "@mastra/playground-ui": "workspace:*",
    "@mastra/react": "workspace:*",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/core": "2.4.0",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/server": "2.4.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "^5.104.5",
    "@testing-library/react": "^16.3.3",
    "@types/node": "22.19.15",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "4.3.3",
    "tsdown": "0.23.1",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
