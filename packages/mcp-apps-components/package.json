{
  "name": "@mastra/mcp-apps-components",
  "version": "0.1.0-alpha.0",
  "description": "Prebuilt MCP Apps that render Mastra UI components, ready to register as MCP server app resources",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    "./dashboard-renderer": {
      "import": {
        "types": "./dist/dashboard-renderer.d.ts",
        "default": "./dist/dashboard-renderer.js"
      },
      "require": {
        "types": "./dist/dashboard-renderer.d.ts",
        "default": "./dist/dashboard-renderer.cjs"
      }
    },
    "./observability-tools": {
      "import": {
        "types": "./dist/observability-tools.d.ts",
        "default": "./dist/observability-tools.js"
      },
      "require": {
        "types": "./dist/observability-tools.d.ts",
        "default": "./dist/observability-tools.cjs"
      }
    },
    "./host": {
      "import": {
        "types": "./dist/host.d.ts",
        "default": "./dist/host.js"
      },
      "require": {
        "types": "./dist/host.d.ts",
        "default": "./dist/host.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "homepage": "https://mastra.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mastra-ai/mastra.git",
    "directory": "packages/mcp-apps-components"
  },
  "bugs": {
    "url": "https://github.com/mastra-ai/mastra/issues"
  },
  "scripts": {
    "build": "tsx scripts/build-apps.ts && tsdown --silent --config tsdown.config.ts",
    "test": "vitest run --project 'unit:packages/mcp-apps-components'",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware .",
    "lint:fix": "oxlint --type-aware --fix ."
  },
  "peerDependencies": {
    "@mastra/core": ">=1.81.0-0 <2.0.0-0",
    "@mastra/mcp": ">=2.9.0-0 <3.0.0-0",
    "@mastra/server": ">=1.83.0-0 <2.0.0-0",
    "react": ">=19.0.0",
    "zod": "^4.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.3",
    "@internal/lint": "workspace:*",
    "@internal/types-builder": "workspace:*",
    "@mastra/client-js": "workspace:*",
    "@mastra/core": "workspace:*",
    "@mastra/hono": "workspace:*",
    "@mastra/mcp": "workspace:*",
    "@mastra/playground-ui": "workspace:*",
    "@mastra/react": "workspace:*",
    "@mastra/server": "workspace:*",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/core": "2.4.0",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/server": "2.4.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "^5.104.5",
    "@testing-library/react": "^16.3.3",
    "@types/node": "22.19.15",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "hono": "^4.13.13",
    "jsdom": "^30.1.3",
    "msw": "^2.15.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "4.3.3",
    "tsdown": "0.23.1",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
