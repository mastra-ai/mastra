{
  "$schema": "https://v2-9-16.turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "build:lib": {
      "dependsOn": [
        "^build",
        "@mastra/server#generate:api-cli-route-metadata",
        "@mastra/factory#generate:api-cli-route-metadata"
      ],
      "inputs": ["$TURBO_DEFAULT$", "./tsdown.config.ts"],
      "outputs": ["dist/**", "!dist/docs/**"]
    },
    "build": {
      "dependsOn": ["^build", "build:lib", "@internal/playground#build"],
      "inputs": ["package.json"],
      "outputs": ["dist/**", "!dist/docs/**"]
    }
  }
}
