    "url": "https://github.com/mastra-ai/mastra/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./scorers/prebuilt": {
      "import": {
        "types": "./dist/scorers/prebuilt/index.d.ts",
        "default": "./dist/scorers/prebuilt/index.js"
      },
      "require": {
        "types": "./dist/scorers/prebuilt/index.d.ts",
        "default": "./dist/scorers/prebuilt/index.cjs"
      }
    },
    "./scorers/utils": {
      "import": {
        "types": "./dist/scorers/utils.d.ts",
        "default": "./dist/scorers/utils.js"
      },
      "require": {
        "types": "./dist/scorers/utils.d.ts",
        "default": "./dist/scorers/utils.cjs"
      }
    },
    "./checks": {
      "import": {
        "types": "./dist/checks.d.ts",
        "default": "./dist/checks.js"
      },
      "require": {
        "types": "./dist/checks.d.ts",
        "default": "./dist/checks.cjs"
      }
    },
    "./vitest": {
      "import": {
        "types": "./dist/vitest/index.d.ts",
        "default": "./dist/vitest/index.js"
      },
      "require": {
        "types": "./dist/vitest/index.d.ts",
        "default": "./dist/vitest/index.cjs"
      }
    },
    "./vitest/setup": {
      "import": {
        "types": "./dist/vitest/setup.d.ts",
        "default": "./dist/vitest/setup.js"
      },
      "require": {
        "types": "./dist/vitest/setup.d.ts",
        "default": "./dist/vitest/setup.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build:lib": "pnpm check && tsdown --silent --config tsdown.config.ts",
    "prepack": "tsx ../../scripts/generate-package-docs.ts",
    "build:watch": "pnpm build:lib --watch",
    "test": "vitest",
    "lint": "oxlint . && eslint .",
    "lint:fix": "oxlint --fix . && eslint --fix ."
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
