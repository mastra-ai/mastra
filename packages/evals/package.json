    "vitest": ">=3.0.0 <5.0.0"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/openai": "^1.3.24",
    "@ai-sdk/openai-v6": "npm:@ai-sdk/openai@3.0.88",
    "@copilotkit/aimock": "^1.29.0",
    "@internal/ai-sdk-v5": "workspace:*",
    "@internal/lint": "workspace:*",
