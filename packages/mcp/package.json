{
  "name": "@mastra/mcp",
  "version": "1.18.1-alpha.1",
  "description": "",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build:lib": "tsdown --silent --config tsdown.config.ts",
    "prepack": "tsx ../../scripts/generate-package-docs.ts",
    "build:watch": "pnpm build:lib --watch",
    "test:client": "vitest run --project unit:packages/mcp ./src/client",
    "test:client:e2e": "vitest run --project e2e:packages/mcp ./src/client",
    "test:server": "vitest run ./src/server",
    "test:integration": "cd integration-tests && pnpm test:mcp",
    "test:compat": "bash integration-tests/compat.sh",
    "test:conformance": "tsx ./src/conformance/run.ts",
    "test": "pnpm test:server && pnpm test:client && pnpm test:integration",
    "lint": "oxlint . && eslint .",
    "lint:fix": "oxlint --fix . && eslint --fix ."
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/core": "2.0.0",
    "@modelcontextprotocol/ext-apps": "^2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "exit-hook": "^5.1.0",
    "fast-deep-equal": "^3.1.3"
  },
  "peerDependencies": {
    "@mastra/core": ">=1.68.0-0 <2.0.0-0"
  },
  "devDependencies": {
    "@internal/ai-sdk-v5": "workspace:*",
    "@internal/lint": "workspace:*",
    "@internal/llm-recorder": "workspace:*",
    "@internal/test-utils": "workspace:*",
    "@internal/types-builder": "workspace:*",
    "@mastra/core": "workspace:*",
    "@mastra/observability": "workspace:*",
    "@mastra/schema-compat": "workspace:*",
    "@mendable/firecrawl-js": "^1.29.3",
    "@modelcontextprotocol/conformance": "0.2.0-alpha.11",
    "@types/node": "22.20.1",
    "@types/semver": "^7.7.1",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "eslint": "^10.7.0",
    "semver": "^7.8.5",
    "tsdown": "0.22.9",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:",
    "zod-to-json-schema": "^3.25.1"
  },
  "homepage": "https://mastra.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mastra-ai/mastra.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/mastra-ai/mastra/issues"
