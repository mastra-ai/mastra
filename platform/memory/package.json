{
  "name": "@mastra/platform-memory",
  "version": "0.0.0",
  "description": "Mastra Platform hosted Memory: API client and PlatformMemory for agents",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./ai-sdk": {
      "import": {
        "types": "./dist/ai-sdk.d.ts",
        "default": "./dist/ai-sdk.js"
      },
      "require": {
        "types": "./dist/ai-sdk.d.ts",
        "default": "./dist/ai-sdk.cjs"
      }
    },
    "./langchain": {
      "import": {
        "types": "./dist/langchain.d.ts",
        "default": "./dist/langchain.js"
      },
      "require": {
        "types": "./dist/langchain.d.ts",
        "default": "./dist/langchain.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown --silent --config tsdown.config.ts",
    "build:lib": "pnpm build",
    "build:watch": "pnpm build --watch",
    "test:unit": "vitest run",
    "test": "pnpm test:unit",
    "lint": "oxlint . && eslint .",
    "lint:fix": "oxlint --fix . && eslint --fix ."
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@ai-sdk/provider": "3.0.14",
    "@internal/lint": "workspace:*",
    "@internal/types-builder": "workspace:*",
    "@langchain/core": "^1.0.0",
    "@mastra/core": "workspace:*",
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "ai": "^6.0.0",
    "eslint": "^10.4.1",
    "tsdown": "0.22.9",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@mastra/core": ">=1.62.0-0 <2.0.0-0",
    "@ai-sdk/provider": "^3.0.0",
    "@langchain/core": ">=0.3.0 <2.0.0"
  },
  "files": [
    "dist"
  ],
  "homepage": "https://mastra.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mastra-ai/mastra.git",
    "directory": "platform/memory"
  },
  "bugs": {
    "url": "https://github.com/mastra-ai/mastra/issues"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/provider": {
      "optional": true
    },
    "@langchain/core": {
      "optional": true
    }
  }
}
