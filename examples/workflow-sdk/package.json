    "workflow": "5.0.0-beta.36",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "@mastra/core": "link:../../packages/core",
