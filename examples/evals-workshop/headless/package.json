{
  "name": "@workshop/headless",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "CI-safe eval exercises — deterministic, no server, temp database",
  "scripts": {
    "ex:1": "tsx --env-file-if-exists=../.env src/01-custom-scorer.ts",
    "ex:2": "tsx --env-file-if-exists=../.env src/02-prebuilt-scorers.ts",
    "ex:3": "tsx --env-file-if-exists=../.env src/03-gates-and-thresholds.ts",
    "ex:4": "tsx --env-file-if-exists=../.env src/04-multi-turn.ts",
    "ex:5": "tsx --env-file-if-exists=../.env src/05-workflow-scoring.ts",
    "ex:6": "tsx --env-file-if-exists=../.env src/06-dataset-experiment.ts",
    "ex:7": "tsx --env-file-if-exists=../.env src/07-evals-with-memory.ts",
    "ex:offline": "pnpm ex:1 && pnpm ex:3 && pnpm ex:4 && pnpm ex:5 && pnpm ex:6 && pnpm ex:7",
    "ex:all": "pnpm ex:1 && pnpm ex:2 && pnpm ex:3 && pnpm ex:4 && pnpm ex:5 && pnpm ex:6 && pnpm ex:7",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf node_modules"
  },
  "dependencies": {
    "@mastra/core": "catalog:",
    "@mastra/evals": "catalog:",
    "@mastra/libsql": "catalog:",
    "@mastra/memory": "catalog:",
    "@workshop/shared": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
