# LiveKit Cloud credentials
# Create a free project at https://cloud.livekit.io, then Settings -> API Keys.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional: use the same name in the server and worker to isolate this deployment.
# LIVEKIT_AGENT_NAME=mastra-voice

# Optional automatic recording for Meridian calls. Disabled by default.
# Starts when the room is created, BEFORE joining or collecting in-call consent.
# Requires an egress service and writable S3 storage; incurs recording/storage usage.
# Keep false for the regulated demo. Its consent tools do not control LiveKit recording.
LIVEKIT_RECORDING_ENABLED=false
RECORDINGS_S3_BUCKET=
RECORDINGS_S3_REGION=
RECORDINGS_S3_ACCESS_KEY=
RECORDINGS_S3_SECRET=
# Optional for S3-compatible storage. Must be reachable by LiveKit and the browser.
# RECORDINGS_S3_ENDPOINT=https://your-storage-endpoint

# LLM for the Mastra agent (the agent uses model 'openai/gpt-5-mini')
OPENAI_API_KEY=

# Where the plugin worker (`pnpm worker:plugin`) reaches the Mastra server. Defaults to the
# local `pnpm dev` server; point it at your deployed app to run the worker truly remote.
# MASTRA_URL=http://localhost:4111
