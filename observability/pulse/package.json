{
  "name": "@mastra/pulse",
  "version": "0.0.1-alpha.0",
  "description": "Experimental adapters for Mastra's event-first (Pulse) observability pipeline \u2014 standalone ClickHouse HTTP writer, table schema, and span backfill. The pipeline itself lives in @mastra/core (`new Mastra({ pulse })`)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown --silent --config tsdown.config.ts",
    "build:watch": "pnpm build --watch",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "lint": "oxlint . && eslint .",
    "lint:fix": "oxlint --fix . && eslint --fix ."
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@internal/lint": "workspace:*",
    "@internal/types-builder": "workspace:*",
    "@mastra/observability": "workspace:*",
    "@mastra/core": "workspace:*",
    "@types/node": "22.20.1",
    "eslint": "^10.7.0",
    "tsdown": "0.22.9",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@mastra/clickhouse": "workspace:*"
  },
  "peerDependencies": {
    "@mastra/core": ">=1.16.0-0 <2.0.0-0"
  },
  "homepage": "https://mastra.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mastra-ai/mastra.git",
    "directory": "observability/pulse"
  },
  "bugs": {
    "url": "https://github.com/mastra-ai/mastra/issues"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
