{
  "name": "mastracode-web",
  "version": "0.1.0",
  "description": "MastraCode web host: API routes, deployable Mastra entry, and server/controller scenario tests. Standalone pnpm project consuming monorepo packages via link: — run pnpm install at the monorepo root first; `pnpm prebuild` builds the linked packages (web:build / build:ui run it automatically). The SPA UI lives in mastracode/factory-ui (linked via @internal/factory-ui).",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "prebuild": "cd ../.. && pnpm turbo build --filter ./mastracode/sdk --filter ./mastracode/factory --filter ./packages/playground-ui --filter ./client-sdks/client-js --filter ./client-sdks/react --filter ./stores/libsql --filter ./stores/pg --filter ./auth/better-auth --filter ./auth/workos --filter ./auth/studio --filter ./server-adapters/hono --filter ./workspaces/platform-workspace --filter ./workspaces/railway --filter ./pubsub/redis-streams --filter ./packages/cli",
    "api": "PORT=${PORT:-4111} MASTRACODE_PUBLIC_URL=${MASTRACODE_PUBLIC_URL:-http://localhost:5173} MASTRA_SKIP_PEERDEP_CHECK=1 varlock run -- mastra factory dev --dir src/mastra",
    "dev": "PORT=5873 MASTRA_SKIP_PEERDEP_CHECK=1 varlock run -- mastra factory dev --dir src/mastra",
    "dev:github": "pnpm db:up && pnpm dev",
    "build": "node scripts/monorepo-deps.mjs run -- mastra build --dir src/mastra",
    "deploy": "pnpm run build && node scripts/validate-output.mjs && mastra deploy --skip-build",
    "start": "varlock run -- mastra start",
    "test": "vitest run"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "@duckdb/node-bindings": "1.5.4-r.1",
    "@internal/factory-ui": "link:../factory-ui",
    "@mastra/auth-better-auth": "link:../../auth/better-auth",
    "@mastra/auth-studio": "link:../../auth/studio",
    "@mastra/auth-workos": "link:../../auth/workos",
    "@mastra/client-js": "link:../../client-sdks/client-js",
    "@mastra/code-sdk": "link:../sdk",
    "@mastra/core": "link:../../packages/core",
    "@mastra/factory": "link:../factory",
    "@mastra/hono": "link:../../server-adapters/hono",
    "@mastra/libsql": "link:../../stores/libsql",
    "@mastra/pg": "link:../../stores/pg",
    "@mastra/platform-workspace": "link:../../workspaces/platform-workspace",
    "@mastra/railway": "link:../../workspaces/railway",
    "@mastra/redis-streams": "link:../../pubsub/redis-streams",
    "@octokit/auth-app": "^8.0.0",
    "@octokit/rest": "^22.0.1",
    "@workos-inc/node": "8.8.0",
    "debug": "^4.4.3",
    "drizzle-orm": "^0.45.0",
    "hono": "^4.12.8",
    "pg": "^8.21.0",
    "supports-color": "^10.2.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@ai-sdk/openai": "^3.0.86",
    "@copilotkit/aimock": "^1.29.0",
    "@types/node": "22.20.1",
    "@types/pg": "^8.18.0",
    "concurrently": "^9.1.2",
    "mastra": "link:../../packages/cli",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "varlock": "^1.9.0",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
