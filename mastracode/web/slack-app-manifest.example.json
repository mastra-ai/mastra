{
  "display_information": {
    "name": "Mastra Factory (dev)",
    "description": "AI assistant powered by Mastra",
    "background_color": "#000000"
  },
  "features": {
    "app_home": {
      "home_tab_enabled": false,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": false
    },
    "bot_user": {
      "display_name": "Mastra Factory (dev)",
      "always_online": true
    },
    "assistant_view": {
      "assistant_description": "AI assistant powered by Mastra"
    }
  },
  "oauth_config": {
    "redirect_urls": ["https://YOUR-TUNNEL-HOSTNAME/connect/slack/oidc/callback"],
    "scopes": {
      "bot": [
        "chat:write",
        "chat:write.public",
        "im:write",
        "channels:history",
        "channels:read",
        "groups:history",
        "groups:read",
        "im:history",
        "im:read",
        "mpim:history",
        "mpim:read",
        "app_mentions:read",
        "users:read",
        "reactions:write",
        "files:read",
        "assistant:write"
      ]
    },
    "pkce_enabled": false
  },
  "settings": {
    "event_subscriptions": {
      "request_url": "https://YOUR-TUNNEL-HOSTNAME/api/agent-controllers/mastra-code/channels/slack/webhook",
      "bot_events": ["app_mention", "message.channels", "message.groups", "message.im", "message.mpim"]
    },
    "interactivity": {
      "is_enabled": true,
      "request_url": "https://YOUR-TUNNEL-HOSTNAME/api/agent-controllers/mastra-code/channels/slack/webhook"
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false,
    "is_mcp_enabled": false
  }
}
