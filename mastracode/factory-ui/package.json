    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lang-markdown": "^6.3.1",
    "@codemirror/lang-python": "^6.1.6",
    "@codemirror/lang-rust": "^6.0.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.1",
    "@codemirror/language": "^6.10.6",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/merge": "^6.7.1",
    "@codemirror/search": "^6.5.8",
    "@codemirror/state": "^6.5.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.35.3",
    "@fontsource-variable/mona-sans": "5.3.0",
    "@lezer/highlight": "^1.2.1",
    "@mastra/client-js": "workspace:*",
    "@mastra/code-sdk": "workspace:*",
    "@mastra/core": "workspace:*",
    "@mastra/factory": "workspace:*",
    "@mastra/playground-ui": "workspace:*",
    "@mastra/react": "workspace:*",
    "@nangohq/frontend": "0.71.6",
    "@pierre/diffs": "^1.5.1",
    "@pierre/trees": "1.0.0-beta.6",
