{
  "name": "mastra-factory",
  "version": "0.1.0",
  "description": "Mastra Factory: an agent-powered software delivery environment. Intake GitHub/Linear issues, work them with coding agents, and ship pull requests \u2014 all from your own deployable web app.",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "mastra factory dev --dir src/mastra",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "check": "tsc --noEmit",
    "build": "mastra build --dir src/mastra",
    "start": "varlock run -- mastra start",
    "deploy": "mastra deploy"
  },
  "dependencies": {
    "@mastra/auth-workos": "^1.6.4",
    "@mastra/code-sdk": "^1.1.3",
    "@mastra/core": "^1.57.0",
    "@mastra/factory": "^0.5.0",
    "@mastra/libsql": "^1.19.0",
    "@mastra/memory": "^1.26.0",
    "@mastra/pg": "^1.19.0",
    "@mastra/platform-workspace": "^1.1.0",
    "@mastra/redis-streams": "^0.3.0"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "mastra": "^1.23.0",
    "typescript": "^5.9.2",
    "varlock": "^1.9.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
